def images_to_url(images, fallback_url=''):
    """Convert images array to frontend-friendly format.
    Returns an object {lg, md, sm} if images exist, or the fallback URL string."""
    if images and isinstance(images, list) and len(images) > 0:
        img = images[0]
        if isinstance(img, dict):
            return {
                "lg": img.get("lg", fallback_url),
                "md": img.get("md", fallback_url),
                "sm": img.get("sm", fallback_url),
            }
    return fallback_url

def _parse_variants(variants_raw):
    """Validate and normalise a list of variant maps from the request body."""
    if not isinstance(variants_raw, list):
        return []
    parsed = []
    for v in variants_raw:
        if not isinstance(v, dict):
            continue
        variant_id = (v.get("variantId") or str(uuid.uuid4())).strip()
        # Parse variant images
        images_raw = v.get("images") or []
        images_parsed = []
        for img in images_raw:
            if isinstance(img, dict) and img.get("lg"):
                images_parsed.append({"lg": img["lg"], "md": img.get("md", ""), "sm": img.get("sm", "")})
        parsed.append({
            "variantId": variant_id,
            "deviceBrand": (v.get("deviceBrand") or "").strip(),
            "deviceFamily": (v.get("deviceFamily") or "").strip(),
            "model": (v.get("model") or "").strip(),
            "price": Decimal(str(v["price"])) if v.get("price") is not None else None,
            "stock": int(v["stock"]) if v.get("stock") is not None else None,
            "quality": (v.get("quality") or "").strip(),
            "images": images_parsed,
        })
    return parsed


def _extract_device_families(variants_raw):
    """Return a deduplicated list of deviceFamily strings from variants."""
    if not isinstance(variants_raw, list):
        return []
    seen = set()
    families = []
    for v in variants_raw:
        if not isinstance(v, dict):
            continue
        fam = (v.get("deviceFamily") or "").strip()
        if fam and fam not in seen:
            seen.add(fam)
            families.append(fam)
    return families



def capture_notification_result(notifications, key, result):
    entry = dict(notifications.get(key) or {})
    if result.get("ok"):
        entry["sentAt"] = now_iso()
        entry["lastAttemptAt"] = entry["sentAt"]
        entry["status"] = "SENT"
        entry["messageId"] = result.get("messageId", "")
        entry.pop("error", None)
    else:
        entry["lastAttemptAt"] = now_iso()
        entry["status"] = "FAILED"
        entry["error"] = result.get("error", "unknown_error")
    notifications[key] = entry


def send_ses_email(sender, recipient, subject, text_body, html_body):
    result = ses.send_email(
        FromEmailAddress=sender,
        Destination={"ToAddresses": [recipient]},
        Content={
            "Simple": {
                "Subject": {"Data": subject, "Charset": "UTF-8"},
                "Body": {
                    "Text": {"Data": text_body, "Charset": "UTF-8"},
                    "Html": {"Data": html_body, "Charset": "UTF-8"},
                },
            }
        },
    )
    return result.get("MessageId", "")


def send_smtp_email(sender, recipient, subject, text_body, html_body):
    host = get_smtp_host()
    port = get_smtp_port()
    username = get_smtp_username()
    password = get_smtp_password()
    if not host or not username or not password:
        raise RuntimeError("smtp_not_configured")

    msg = EmailMessage()
    msg["Subject"] = subject
    msg["From"] = formataddr(("RepuestosCel", sender or username))
    msg["To"] = recipient
    msg["Reply-To"] = sender or username
    msg.set_content(text_body or "")
    msg.add_alternative(html_body or text_body or "", subtype="html")

    timeout = 12
    if port == 465:
        context = ssl.create_default_context()
        with smtplib.SMTP_SSL(host, port, context=context, timeout=timeout) as smtp:
            smtp.login(username, password)
            smtp.send_message(msg)
    else:
        context = ssl.create_default_context()
        with smtplib.SMTP(host, port, timeout=timeout) as smtp:
            smtp.ehlo()
            smtp.starttls(context=context)
            smtp.ehlo()
            smtp.login(username, password)
            smtp.send_message(msg)
    return f"smtp-{uuid.uuid4()}"


def send_email(recipient, subject, text_body, html_body):
    provider = get_email_provider()
    sender = get_order_notifications_from_email() or get_smtp_username()
    if not sender or not recipient:
        return {
            "ok": False,
            "error": "missing_sender_or_recipient",
        }
    try:
        if provider == "smtp":
            message_id = send_smtp_email(sender, recipient, subject, text_body, html_body)
        else:
            message_id = send_ses_email(sender, recipient, subject, text_body, html_body)
        return {
            "ok": True,
            "messageId": message_id,
        }
    except Exception as exc:
        print(json.dumps({
            "event": "send_email_failed",
            "provider": provider,
            "recipient": recipient,
            "error": str(exc),
        }))
        return {
            "ok": False,
            "error": str(exc),
        }



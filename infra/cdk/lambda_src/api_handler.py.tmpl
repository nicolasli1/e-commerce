def handle_dashboard():
    products = products_table.scan().get("Items", [])
    products = [product for product in products if not is_site_settings_item(product)]
    leads = leads_table.scan().get("Items", [])
    quotes = quotes_table.scan().get("Items", [])
    orders = orders_table.scan().get("Items", [])
    active_products = [p for p in products if p.get("status", "active") != "deleted"]
    quotes_sorted = sorted(quotes, key=lambda x: x.get("createdAt", ""), reverse=True)
    orders_sorted = sorted(orders, key=lambda x: x.get("createdAt", ""), reverse=True)
    ready_orders = [
        order for order in orders
        if order.get("status") == "APPROVED" and order.get("fulfillmentStatus") in ("READY_TO_FULFILL", "PROCESSING")
    ]
    pending_orders = [o for o in orders if o.get("status") in ("CHECKOUT_CREATED", "PENDING")]
    approved_orders = [o for o in orders if o.get("status") == "APPROVED"]
    total_revenue = sum(o.get("amountInCents", 0) for o in approved_orders)
    # Count by status
    order_statuses = {}
    for o in orders:
        st = o.get("status", "UNKNOWN")
        order_statuses[st] = order_statuses.get(st, 0) + 1
    fulfillment_statuses = {}
    for o in orders:
        fs = o.get("fulfillmentStatus", "UNKNOWN")
        fulfillment_statuses[fs] = fulfillment_statuses.get(fs, 0) + 1
    # ── Sales chart data (7 days) ──
    from datetime import datetime as dt, timedelta
    today = dt.now(timezone.utc).date()
    daily_labels = []
    daily_values = []
    for i in range(6, -1, -1):
        day = today - timedelta(days=i)
        label = day.strftime("%a")  # Mon, Tue, Wed...
        day_total = sum(
            o.get("amountInCents", 0) for o in orders
            if o.get("createdAt", "").startswith(day.isoformat())
            and o.get("status") == "APPROVED"
        )
        daily_labels.append(label)
        daily_values.append(day_total // 100)

    # ── Hourly distribution (mock until real data builds) ──
    hourly = []
    for h in range(24):
        hour_label = f"{h:02d}:00"
        hour_total = sum(
            o.get("amountInCents", 0) for o in orders
            if o.get("status") == "APPROVED"
            and o.get("createdAt", "")[11:13] == f"{h:02d}"
        )
        hourly.append(hour_total // 100)

    # ── Monthly ──
    months_map = {}
    for o in orders:
        if o.get("status") != "APPROVED":
            continue
        created = o.get("createdAt", "")
        if not created:
            continue
        month_key = created[:7]  # "2026-05"
        months_map[month_key] = months_map.get(month_key, 0) + (o.get("amountInCents", 0) // 100)
    monthly_labels = sorted(months_map.keys())
    monthly_values = [months_map[m] for m in monthly_labels]

    return response(200, {
        "ok": True,
        "totalProducts": len(active_products),
        "totalLeads": len(leads),
        "totalUsers": 0,
        "totalQuotes": len(quotes),
        "totalOrders": len(orders),
        "pendingOrders": len(pending_orders),
        "approvedOrders": len(approved_orders),
        "readyToFulfillOrders": len(ready_orders),
        "totalRevenueInCents": total_revenue,
        "orderStatuses": order_statuses,
        "fulfillmentStatuses": fulfillment_statuses,
        "salesChart": {
            "daily": {"labels": daily_labels, "values": daily_values},
            "hourly": {"labels": [f"{h:02d}" for h in range(24)], "values": hourly},
            "monthly": {"labels": monthly_labels, "values": monthly_values},
        },
        "recentQuotes": [{
            "name": q.get("name", ""),
            "email": q.get("email", ""),
            "plan": q.get("plan", ""),
            "status": q.get("status", "pending"),
            "createdAt": q.get("createdAt", ""),
        } for q in quotes_sorted[:5]],
        "recentOrders": [{
            "reference": order.get("reference", ""),
            "status": order.get("status", ""),
            "fulfillmentStatus": order.get("fulfillmentStatus", ""),
            "customerName": (order.get("customer") or {}).get("fullName", ""),
            "amountInCents": order.get("amountInCents", 0),
            "createdAt": order.get("createdAt", ""),
        } for order in orders_sorted[:5]],
    })



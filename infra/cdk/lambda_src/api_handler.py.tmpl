MERCADOPAGO_WEBHOOK_SECRET_PARAM = os.environ.get("MERCADOPAGO_WEBHOOK_SECRET_PARAM", "")

_param_cache = {}


class DecimalEncoder(json.JSONEncoder):
    def default(self, obj):
        from decimal import Decimal as _Decimal
        if isinstance(obj, _Decimal):
            return float(obj)
        return super().default(obj)


def response(status_code, body, extra_headers=None):
    headers = {"Content-Type": "application/json"}
    if extra_headers:
        headers.update(extra_headers)
    return {
        "statusCode": status_code,
        "headers": headers,
        "body": json.dumps(body, cls=DecimalEncoder),
    }


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def cents_to_cop_units(amount_in_cents):
    return int(
        (Decimal(str(amount_in_cents)) / Decimal("100")).quantize(
            Decimal("1"),
            rounding=ROUND_HALF_UP,
        )
    )


def get_json_body(event):
    try:
        return json.loads(event.get("body") or "{}")
    except json.JSONDecodeError:
        return None


def get_parameter(name, decrypt=False):
    if not name:
        return ""
    cache_key = (name, decrypt)
    if cache_key in _param_cache:
        return _param_cache[cache_key]
    result = ssm.get_parameter(Name=name, WithDecryption=decrypt)
    value = result["Parameter"]["Value"]
    _param_cache[cache_key] = value
    return value


def get_wompi_public_key():
    try:
        return get_parameter(WOMPI_PUBLIC_KEY_PARAM, decrypt=False)
    except Exception:
        return ""


def get_wompi_integrity_secret():
    try:
        return get_parameter(WOMPI_INTEGRITY_SECRET_PARAM, decrypt=True)
    except Exception:

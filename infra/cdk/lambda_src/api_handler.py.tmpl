          </table>
        </td>
      </tr>
    </table>
  </body>
</html>"""


def campaign_text_body(title, message, cta_text="", cta_url=""):
    body = f"{title}\n\n{message}\n"
    if cta_text and cta_url:
        body += f"\n{cta_text}: {cta_url}\n"
    body += "\nPara dejar de recibir publicaciones, responde con BAJA.\n"
    return body


def collect_campaign_recipients(audience, test_email=""):
    recipients = {}
    if test_email:
        email = normalize_email(test_email)
        if email:
            recipients[email] = {"email": email, "name": "Prueba"}
        return list(recipients.values())

    if audience in ("leads", "all"):
        for lead in leads_table.scan().get("Items", []):
            email = normalize_email(lead.get("email"))
            if email:
                recipients[email] = {
                    "email": email,
                    "name": lead.get("name", ""),
                    "source": "lead",
                }

    if audience in ("customers", "all"):
        for order in orders_table.scan().get("Items", []):
            customer = order.get("customer") or {}
            email = normalize_email(customer.get("email"))
            if email:
                recipients[email] = {
                    "email": email,
                    "name": customer.get("fullName", ""),
                    "source": "customer",
                }

    return list(recipients.values())


def send_campaign(body):
    body = body if isinstance(body, dict) else {}
    subject = (body.get("subject") or "").strip()
    title = (body.get("title") or "").strip()
    preheader = (body.get("preheader") or "").strip() or title
    message = (body.get("message") or "").strip()
    cta_text = (body.get("ctaText") or "").strip()
    cta_url = (body.get("ctaUrl") or "").strip()
    audience = (body.get("audience") or "test").strip()
    test_email = (body.get("testEmail") or "").strip()
    dry_run = bool(body.get("dryRun"))

    if audience not in ("test", "leads", "customers", "all"):
        return response(400, {"error": "invalid_audience"})
    if not subject or not title or not message:
        return response(400, {"error": "missing_campaign_fields"})
    if audience == "test" and not test_email:
        return response(400, {"error": "missing_test_email"})
    if get_email_provider() == "smtp" and audience != "test" and not dry_run:
        return response(403, {
            "error": "smtp_campaigns_disabled",
            "message": "Las publicaciones masivas están deshabilitadas con SMTP. Usa pruebas o un proveedor de marketing con bajas automáticas.",
        })

    recipients = collect_campaign_recipients(audience, test_email if audience == "test" else "")
    max_recipients = min(safe_int(body.get("limit"), 50), 100)
    recipients = recipients[:max_recipients]
    if dry_run:
        return response(200, {"ok": True, "dryRun": True, "recipients": len(recipients)})

    html_body = campaign_email_shell(preheader, title, message, cta_text, cta_url)
    text_body = campaign_text_body(title, message, cta_text, cta_url)
    sent = []
    failed = []
    for recipient in recipients:
        result = send_email(recipient["email"], subject, text_body, html_body)
        entry = {"email": recipient["email"], "messageId": result.get("messageId", "")}
        if result.get("ok"):
            sent.append(entry)
        else:
            entry["error"] = result.get("error", "unknown_error")
            failed.append(entry)

    return response(200, {
        "ok": True,
        "audience": audience,
        "attempted": len(recipients),
        "sent": len(sent),
        "failed": len(failed),
        "failures": failed[:10],
    })


def maybe_send_notification(notifications, key, send_result):
    entry = dict(notifications.get(key) or {})
    if entry.get("status") == "SENT":
        return False
    capture_notification_result(notifications, key, send_result)
    return True


def sync_order_inventory(order, previous_order=None):
    if not order or order.get("status") != "APPROVED":
        return order, {}

    previous_order = previous_order or {}
    inventory = dict(order.get("inventory") or {})
    if inventory.get("stockDeductedAt"):
        return order, {}
    if previous_order.get("status") == "APPROVED":
        return order, {}

    errors = []
    for item in order.get("items", []):
        product_id = item.get("productId")
        variant_id = item.get("variantId") or ""
        quantity = max(1, safe_int(item.get("quantity"), 1))
        if not product_id:
            continue
        try:
            product = products_table.get_item(Key={"productId": product_id}).get("Item")
            variants = product.get("variants") if product and isinstance(product.get("variants"), list) else []
            if variant_id and variants:
                matched = False
                updated_variants = []
                for variant in variants:
                    variant_copy = dict(variant)
                    if variant_copy.get("variantId") == variant_id:
                        matched = True
                        current_stock = safe_int(variant_copy.get("stock"), 0)
                        if current_stock < quantity:
                            raise ValueError("insufficient_variant_stock")
                        variant_copy["stock"] = current_stock - quantity
                    updated_variants.append(variant_copy)
                if not matched:
                    raise ValueError("variant_not_found")
                aggregate_stock = _derive_product_fields_from_variants(updated_variants)["stock"]
                products_table.update_item(
                    Key={"productId": product_id},
                    UpdateExpression="SET #variants = :variants, #stock = :stock, #updatedAt = :updatedAt",
                    ConditionExpression="attribute_exists(productId)",
                    ExpressionAttributeNames={
                        "#variants": "variants",
                        "#stock": "stock",
                        "#updatedAt": "updatedAt",
                    },
                    ExpressionAttributeValues={
                        ":variants": updated_variants,
                        ":stock": aggregate_stock,
                        ":updatedAt": now_iso(),
                    },
                )
            else:
                products_table.update_item(
                    Key={"productId": product_id},
                    UpdateExpression="SET #stock = #stock - :qty, #updatedAt = :updatedAt",
                    ConditionExpression="attribute_exists(productId) AND #stock >= :qty",
                    ExpressionAttributeNames={
                        "#stock": "stock",
                        "#updatedAt": "updatedAt",
                    },
                    ExpressionAttributeValues={
                        ":qty": quantity,
                        ":updatedAt": now_iso(),
                    },
                )
        except Exception as exc:
            errors.append(f"{product_id}: {exc}")

    if errors:
        inventory["status"] = "FAILED"
        inventory["lastAttemptAt"] = now_iso()
        inventory["error"] = "; ".join(errors)
    else:
        inventory["status"] = "DEDUCTED"
        inventory["stockDeductedAt"] = now_iso()
        inventory["lastAttemptAt"] = inventory["stockDeductedAt"]
        inventory.pop("error", None)
    return order, {"inventory": inventory}


def sync_order_notifications(order, previous_order=None):
    if not order:
        return order
    notifications = dict(order.get("notifications") or {})
    updates = {}
    previous_order = previous_order or {}
    previous_status = previous_order.get("status")
    previous_fulfillment = previous_order.get("fulfillmentStatus")

    order, inventory_updates = sync_order_inventory(order, previous_order=previous_order)
    updates.update(inventory_updates)

    if order.get("status") == "APPROVED":
        if order.get("fulfillmentStatus") in ("", "PENDING_PAYMENT", None):
            updates["fulfillmentStatus"] = "READY_TO_FULFILL"

        customer_confirmation = dict(notifications.get("customerConfirmation") or {})
        if customer_confirmation.get("status") != "SENT":
            maybe_send_notification(
                notifications,
                "customerConfirmation",
                send_customer_confirmation(order),
            )

        internal_alert = dict(notifications.get("internalAlert") or {})
        if internal_alert.get("status") != "SENT":
            maybe_send_notification(
                notifications,
                "internalAlert",
                send_internal_order_alert(order),
            )

    stage_notifications = [
        (
            order.get("fulfillmentStatus") == "SHIPPED" and previous_fulfillment != "SHIPPED",
            "shipmentUpdate",
            "shipped",
        ),
        (
            order.get("fulfillmentStatus") == "DELIVERED" and previous_fulfillment != "DELIVERED",
            "deliveryUpdate",
            "delivered",
        ),
        (
            order.get("fulfillmentStatus") == "CANCELLED" and previous_fulfillment != "CANCELLED",
            "cancellationUpdate",
            "cancelled",
        ),
        (
            order.get("status") == "REFUNDED" and previous_status != "REFUNDED",
            "refundUpdate",
            "refunded",
        ),
    ]
    for should_send, notification_key, stage in stage_notifications:
        if not should_send:
            continue
        maybe_send_notification(
            notifications,
            notification_key,
            send_order_status_update(order, stage),
        )

    if notifications != dict(order.get("notifications") or {}):
        updates["notifications"] = notifications

    if not updates:
        return order

    updates["updatedAt"] = now_iso()
    update_expr = "SET " + ", ".join(f"#{k}=:{k}" for k in updates)
    attr_names = {f"#{k}": k for k in updates}
    attr_values = {f":{k}": v for k, v in updates.items()}
    orders_table.update_item(
        Key={"reference": order["reference"]},
        UpdateExpression=update_expr,
        ExpressionAttributeNames=attr_names,
        ExpressionAttributeValues=attr_values,
    )
    return orders_table.get_item(Key={"reference": order["reference"]}).get("Item") or order


def ensure_post_payment_side_effects(order, previous_order=None):
    return sync_order_notifications(order, previous_order=previous_order)


def dispatch_post_payment_side_effects(reference):
    """Run post-payment side effects (emails + inventory) out of band.

    Payment providers (e.g. Wompi) time out the webhook in a few seconds. The
    side effects (SES emails + inventory deduction) can take several seconds on
    a cold start, which makes the provider report the webhook as failed even
    though processing succeeds. To respond fast, we self-invoke the Lambda
    asynchronously and do the heavy work there. The side effects are idempotent
    (guarded by notification status + inventory stockDeductedAt), so retries and
    the synchronous fallback are safe.
    """
    function_name = os.environ.get("AWS_LAMBDA_FUNCTION_NAME", "")
    if function_name:
        try:
            lambda_client.invoke(
                FunctionName=function_name,
                InvocationType="Event",
                Payload=json.dumps({"_task": "post_payment_side_effects", "reference": reference}).encode("utf-8"),
            )
            return
        except Exception as exc:
            print(json.dumps({"event": "side_effects_dispatch_failed", "reference": reference, "error": str(exc)}))
    order = orders_table.get_item(Key={"reference": reference}).get("Item")
    if order:
        ensure_post_payment_side_effects(order)


def normalize_customer(body):
    customer = body.get("customer") or {}
    full_name = (customer.get("fullName") or "").strip()
    email = (customer.get("email") or "").strip().lower()
    phone_number = (customer.get("phoneNumber") or "").strip()
    phone_prefix = (customer.get("phoneNumberPrefix") or "+57").strip()
    legal_id = (customer.get("legalId") or "").strip()
    legal_id_type = (customer.get("legalIdType") or "").strip()
    if not full_name or not email:
        raise ValueError("name_and_email_required")
    return {
        "fullName": full_name,
        "email": email,
        "phoneNumber": phone_number,
        "phoneNumberPrefix": phone_prefix,
        "legalId": legal_id,
        "legalIdType": legal_id_type,
    }


def normalize_shipping(body):
    shipping = body.get("shippingAddress") or {}
    normalized = {
        "addressLine1": (shipping.get("addressLine1") or "").strip(),
        "addressLine2": (shipping.get("addressLine2") or "").strip(),
        "country": (shipping.get("country") or "CO").strip().upper(),
        "city": (shipping.get("city") or "").strip(),
        "phoneNumber": (shipping.get("phoneNumber") or "").strip(),
        "region": (shipping.get("region") or "").strip(),
        "name": (shipping.get("name") or "").strip(),
    }
    required = ["addressLine1", "country", "city", "phoneNumber", "region"]
    if any(normalized[field] for field in normalized):
        if all(normalized[field] for field in required):
            return normalized
    return None


def build_widget_config(reference, amount_in_cents, customer, shipping, redirect_url):
    expiration_time = (datetime.now(timezone.utc) + timedelta(minutes=30)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    signature = build_integrity_signature(reference, amount_in_cents, "COP", expiration_time)
    config = {
        "publicKey": get_wompi_public_key(),
        "currency": "COP",
        "amountInCents": amount_in_cents,
        "reference": reference,
        "redirectUrl": redirect_url,
        "expirationTime": expiration_time,
        "signature": {"integrity": signature},
        "customerData": {
            "email": customer["email"],
            "fullName": customer["fullName"],
            "phoneNumber": customer["phoneNumber"],
            "phoneNumberPrefix": customer["phoneNumberPrefix"],
        },
    }
    if customer.get("legalId") and customer.get("legalIdType"):
        config["customerData"]["legalId"] = customer["legalId"]
        config["customerData"]["legalIdType"] = customer["legalIdType"]
        config["collectCustomerLegalId"] = True
    if shipping:
        config["shippingAddress"] = shipping
        config["collectShipping"] = True
    return config


def mercadopago_base_url():
    return "https://api.mercadopago.com"


def get_api_gateway_origin(event):
    """
    Get the API Gateway public URL for webhook notifications.
    This should always point to the API Gateway (where the Lambda lives),
    NOT the CloudFront frontend.
    """
    headers = event.get("headers", {}) or {}
    host = headers.get("x-forwarded-host") or headers.get("X-Forwarded-Host") \
           or headers.get("host") or headers.get("Host") or ""
    if not host:
        return FRONTEND_URL or ""
    proto = headers.get("x-forwarded-proto") or headers.get("X-Forwarded-Proto") or "https"
    return f"{proto}://{host}"


def build_mercadopago_preference(reference, items, customer, shipping, origin, api_gateway_origin=None):
    access_token = get_mercadopago_access_token()
    if not access_token:
        raise ValueError("mercadopago_not_configured")

    payload = {
        "external_reference": reference,
        "items": [{
            "id": f"{item['productId']}:{item.get('variantId')}" if item.get("variantId") else item["productId"],
            "title": f"{item['name']} {item.get('variantLabel', '')}".strip(),
            "description": item["category"],
            "quantity": item["quantity"],
            "currency_id": "COP",
            "unit_price": cents_to_cop_units(item["unitPriceCents"]),
        } for item in items],
        "payer": {
            "name": customer.get("fullName", ""),
            "email": customer.get("email", ""),
        },
        "payment_methods": {
            "installments": 12,
        },
        "metadata": {
            "reference": reference,
            "integration": "repuestoscel-checkout",
        },
        "back_urls": {
            "success": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
            "failure": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
            "pending": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
        },
        "auto_return": "approved",
        "statement_descriptor": "REPUESTOSCEL",
    }
    if shipping:
        payload["shipments"] = {
            "receiver_address": {
                "zip_code": shipping.get("region", "000000"),
                "street_name": shipping.get("addressLine1", ""),
                "apartment": shipping.get("addressLine2", ""),
                "city_name": shipping.get("city", ""),
                "state_name": shipping.get("region", ""),
                "country_name": shipping.get("country", "CO"),
            }
        }
    # Webhook notifications must go to the API Gateway, not CloudFront
    webhook_origin = api_gateway_origin or origin
    notification_url = f"{webhook_origin}/api/webhooks/mercadopago?source=webhooks" if webhook_origin else ""
    if notification_url:
        payload["notification_url"] = notification_url

    status, data = http_json(
        "POST",
        f"{mercadopago_base_url()}/checkout/preferences",
        headers={"Authorization": f"Bearer {access_token}"},
        body=payload,
    )
    if status not in (200, 201):
        message = (data.get("message") or data.get("error") or "mercadopago_preference_error")
        raise RuntimeError(message)
    return data


def map_mercadopago_status(status):
    mapping = {
        "approved": "APPROVED",
        "authorized": "APPROVED",
        "pending": "PENDING",
        "in_process": "PENDING",
        "in_mediation": "PENDING",
        "rejected": "DECLINED",
        "cancelled": "CANCELLED",
        "charged_back": "CHARGEDBACK",
        "refunded": "REFUNDED",
    }
    return mapping.get((status or "").lower(), (status or "PENDING").upper())


def create_checkout_session(event):
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    provider = (body.get("provider") or "mercadopago").strip().lower()
    if provider not in ("wompi", "mercadopago", "nequi"):
        return response(400, {"error": "unsupported_provider"})
    if provider == "wompi" and not wompi_enabled():
        return response(503, {"error": "checkout_unavailable", "message": "Wompi no está configurado."})
    if provider == "mercadopago" and not mercadopago_enabled():
        return response(503, {"error": "checkout_unavailable", "message": "Mercado Pago no está configurado."})
    if provider == "nequi" and not nequi_enabled():
        return response(503, {"error": "checkout_unavailable", "message": "Nequi no está configurado todavía en este entorno."})
    try:
        customer = normalize_customer(body)
        shipping = normalize_shipping(body)
        items, total_cents = build_order_items(body.get("cart") or [])
    except ValueError as exc:
        return response(400, {"error": str(exc)})

    reference = generate_order_reference()
    origin = get_origin(event)
    redirect_url = f"{origin}/?checkout=return&provider={urllib.parse.quote(provider)}&reference={urllib.parse.quote(reference)}" if origin else ""
    widget_config = None
    mercadopago_config = None
    provider_data = {"name": provider}
    user_id = (body.get("userId") or "").strip()
    if provider == "wompi":
        widget_config = build_widget_config(reference, total_cents, customer, shipping, redirect_url)
        provider_data["wompi"] = {
            "environment": "sandbox" if get_wompi_public_key().startswith("pub_test_") else "production",
            "transactionId": "",
        }
    elif provider == "nequi":
        nequi_phone = normalize_nequi_phone(body.get("nequiPhone") or customer.get("phoneNumber") or "")
        if not nequi_phone:
            return response(400, {"error": "nequi_phone_required", "message": "Ingresa el número de celular Nequi."})
        amount_cop = total_cents // 100
        ok, tx_id, err = initiate_nequi_push_payment(nequi_phone, amount_cop, reference)
        if not ok:
            return response(502, {"error": "nequi_push_failed", "message": f"No pudimos enviar la notificación Nequi: {err}"})
        provider_data["nequi"] = {
            "transactionId": tx_id,
            "phone": nequi_phone,
            "status": "PENDING",
            "statusMessage": "Notificación enviada a la app Nequi",
        }
    else:
        api_gateway_origin = get_api_gateway_origin(event)
        preference = build_mercadopago_preference(reference, items, customer, shipping, origin, api_gateway_origin=api_gateway_origin)
        mercadopago_config = {
            "publicKey": get_mercadopago_public_key(),
            "preferenceId": preference.get("id", ""),
            "initPoint": preference.get("init_point", ""),
            "sandboxInitPoint": preference.get("sandbox_init_point", ""),
        }
        provider_data["mercadopago"] = {
            "preferenceId": preference.get("id", ""),
            "paymentId": "",
            "initPoint": preference.get("init_point", ""),
        }
    order = {
        "reference": reference,
        "orderId": str(uuid.uuid4()),
        "status": "CHECKOUT_CREATED",
        "statusMessage": "Checkout creado y listo para pago",
        "fulfillmentStatus": "PENDING_PAYMENT",
        "currency": "COP",
        "amountInCents": total_cents,
        "items": items,
        "customer": customer,
        "shippingAddress": shipping,
        "notes": (body.get("notes") or "").strip(),
        "redirectUrl": redirect_url,
        "provider": provider,
        "providerData": provider_data,
        "trackingNumber": "",
        "courier": "",
        "fulfillmentNotes": "",
        "notifications": {},
        "userId": user_id if user_id else None,
        "createdAt": now_iso(),
        "updatedAt": now_iso(),
    }
    orders_table.put_item(Item=order)
    payload = {
        "ok": True,
        "reference": reference,
        "order": order,
    }
    if widget_config:
        payload["wompi"] = widget_config
    if mercadopago_config:
        payload["mercadopago"] = mercadopago_config
    return response(201, payload)


def fetch_wompi_transaction(transaction_id):
    public_key = get_wompi_public_key()
    if not public_key:
        return None
    url = f"{wompi_base_url(public_key)}/transactions/{transaction_id}"
    status, payload = http_json(
        "GET",
        url,
        headers={"Authorization": f"Bearer {public_key}"},
    )
    if status != 200:
        return None
    return payload.get("data")


def verify_wompi_transaction_with_provider(transaction):
    transaction_id = transaction.get("id", "")
    if not transaction_id:
        return False, None, "missing_transaction_id"
    provider_transaction = fetch_wompi_transaction(transaction_id)
    if not provider_transaction:
        return False, None, "provider_lookup_failed"
    comparisons = {
        "reference": transaction.get("reference") == provider_transaction.get("reference"),
        "status": transaction.get("status") == provider_transaction.get("status"),
        "amount": safe_int(transaction.get("amount_in_cents"), 0) == safe_int(provider_transaction.get("amount_in_cents"), 0),
    }
    if not all(comparisons.values()):
        print(json.dumps({
            "event": "wompi_webhook_provider_mismatch",
            "transactionId": transaction_id,
            "receivedReference": transaction.get("reference", ""),
            "providerReference": provider_transaction.get("reference", ""),
            "comparisons": comparisons,
        }))
        return False, provider_transaction, "provider_mismatch"
    return True, provider_transaction, ""


def update_order_from_transaction(reference, transaction):
    if not transaction:
        return None
    status = transaction.get("status", "PENDING")
    previous_order = orders_table.get_item(Key={"reference": reference}).get("Item")
    expected_amount = safe_int(previous_order.get("amountInCents"), 0) if previous_order else 0
    paid_amount = safe_int(transaction.get("amount_in_cents"), 0)
    currency = (transaction.get("currency") or "COP").upper()
    if status == "APPROVED" and (not previous_order or previous_order.get("provider") != "wompi" or paid_amount != expected_amount or currency != "COP"):
        print(json.dumps({
            "event": "wompi_payment_rejected_by_integrity_check",
            "reference": reference,
            "provider": previous_order.get("provider", "") if previous_order else "",
            "expectedAmount": expected_amount,
            "paidAmount": paid_amount,
            "currency": currency,
        }))
        if previous_order:
            orders_table.update_item(
                Key={"reference": reference},
                UpdateExpression="SET #statusMessage=:message, #updatedAt=:updatedAt, #wompi=:wompi",
                ExpressionAttributeNames={
                    "#statusMessage": "statusMessage",
                    "#updatedAt": "updatedAt",
                    "#wompi": "wompi",
                },
                ExpressionAttributeValues={
                    ":message": "Pago recibido con datos inconsistentes. Revisión manual requerida.",
                    ":updatedAt": now_iso(),
                    ":wompi": {
                        "environment": "sandbox" if get_wompi_public_key().startswith("pub_test_") else "production",
                        "transactionId": transaction.get("id", ""),
                        "paymentMethodType": transaction.get("payment_method_type", ""),
                        "status": status,
                        "integrity": "REJECTED",
                    },
                },
            )
        return orders_table.get_item(Key={"reference": reference}).get("Item") if previous_order else None
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression="SET #status=:status, #statusMessage=:message, #updatedAt=:updatedAt, #wompi=:wompi, #fulfillmentStatus=if_not_exists(#fulfillmentStatus, :fulfillmentDefault)",
        ExpressionAttributeNames={
            "#status": "status",
            "#statusMessage": "statusMessage",
            "#updatedAt": "updatedAt",
            "#wompi": "wompi",
            "#fulfillmentStatus": "fulfillmentStatus",
        },
        ExpressionAttributeValues={
            ":status": status,
            ":message": transaction.get("status_message", status),
            ":updatedAt": now_iso(),
            ":fulfillmentDefault": "PENDING_PAYMENT",
            ":wompi": {
                "environment": "sandbox" if get_wompi_public_key().startswith("pub_test_") else "production",
                "transactionId": transaction.get("id", ""),
                "paymentMethodType": transaction.get("payment_method_type", ""),
                "status": status,
            },
        },
    )
    dispatch_post_payment_side_effects(reference)
    return orders_table.get_item(Key={"reference": reference}).get("Item")


def update_order_from_mercadopago_payment(reference, payment):
    if not payment:
        return None
    mapped_status = map_mercadopago_status(payment.get("status"))
    current = orders_table.get_item(Key={"reference": reference}).get("Item") or {}
    expected_amount = safe_int(current.get("amountInCents"), 0)
    paid_amount = int(Decimal(str(payment.get("transaction_amount") or 0)) * 100)
    currency = (payment.get("currency_id") or "COP").upper()
    if mapped_status == "APPROVED" and (current.get("provider") != "mercadopago" or paid_amount != expected_amount or currency != "COP"):
        print(json.dumps({
            "event": "mercadopago_payment_rejected_by_integrity_check",
            "reference": reference,
            "provider": current.get("provider", ""),
            "expectedAmount": expected_amount,
            "paidAmount": paid_amount,
            "currency": currency,
        }))
        if current:
            provider_data = current.get("providerData", {})
            provider_data["mercadopago"] = {
                "paymentId": payment.get("id", ""),
                "status": payment.get("status", ""),
                "statusDetail": payment.get("status_detail", ""),
                "externalReference": payment.get("external_reference", ""),
                "integrity": "REJECTED",
            }
            orders_table.update_item(
                Key={"reference": reference},
                UpdateExpression="SET #statusMessage=:message, #updatedAt=:updatedAt, #providerData=:providerData",
                ExpressionAttributeNames={
                    "#statusMessage": "statusMessage",
                    "#updatedAt": "updatedAt",
                    "#providerData": "providerData",
                },
                ExpressionAttributeValues={
                    ":message": "Pago recibido con datos inconsistentes. Revisión manual requerida.",
                    ":updatedAt": now_iso(),
                    ":providerData": provider_data,
                },
            )
        return orders_table.get_item(Key={"reference": reference}).get("Item") if current else None
    provider_data = current.get("providerData", {})
    provider_data["mercadopago"] = {
        "paymentId": payment.get("id", ""),
        "status": payment.get("status", ""),
        "statusDetail": payment.get("status_detail", ""),
        "merchantOrderId": payment.get("order", {}).get("id", ""),
        "externalReference": payment.get("external_reference", ""),
    }
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression="SET #status=:status, #statusMessage=:message, #updatedAt=:updatedAt, #providerData=:providerData, #fulfillmentStatus=if_not_exists(#fulfillmentStatus, :fulfillmentDefault)",
        ExpressionAttributeNames={
            "#status": "status",
            "#statusMessage": "statusMessage",
            "#updatedAt": "updatedAt",
            "#providerData": "providerData",
            "#fulfillmentStatus": "fulfillmentStatus",
        },
        ExpressionAttributeValues={
            ":status": mapped_status,
            ":message": payment.get("status_detail", payment.get("status", mapped_status)),
            ":updatedAt": now_iso(),
            ":fulfillmentDefault": "PENDING_PAYMENT",
            ":providerData": provider_data,
        },
    )
    dispatch_post_payment_side_effects(reference)
    return orders_table.get_item(Key={"reference": reference}).get("Item")


def update_order_from_nequi(reference, transaction_id=None, status_payload=None):
    current = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not current:
        return None
    provider_data = dict(current.get("providerData") or {})
    nequi_data = dict(provider_data.get("nequi") or {})
    transaction_id = transaction_id or nequi_data.get("transactionId", "")
    status_data = extract_nequi_payment_status(status_payload) if status_payload else query_nequi_payment_status(transaction_id)
    mapped_status = status_data.get("status") or "PENDING"
    nequi_data.update({
        "transactionId": status_data.get("transactionId") or transaction_id,
        "status": mapped_status,
        "rawStatus": status_data.get("rawStatus", ""),
        "responseCode": status_data.get("responseCode", ""),
        "statusMessage": status_data.get("statusMessage", mapped_status),
        "lastCheckedAt": now_iso(),
    })
    provider_data["nequi"] = nequi_data
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression="SET #status=:status, #statusMessage=:message, #updatedAt=:updatedAt, #providerData=:providerData, #paymentId=:paymentId, #fulfillmentStatus=if_not_exists(#fulfillmentStatus, :fulfillmentDefault)",
        ExpressionAttributeNames={
            "#status": "status",
            "#statusMessage": "statusMessage",
            "#updatedAt": "updatedAt",
            "#providerData": "providerData",
            "#paymentId": "paymentId",
            "#fulfillmentStatus": "fulfillmentStatus",
        },
        ExpressionAttributeValues={
            ":status": mapped_status,
            ":message": nequi_data["statusMessage"],
            ":updatedAt": now_iso(),
            ":providerData": provider_data,
            ":paymentId": nequi_data.get("transactionId", ""),
            ":fulfillmentDefault": "PENDING_PAYMENT",
        },
    )
    dispatch_post_payment_side_effects(reference)
    return orders_table.get_item(Key={"reference": reference}).get("Item")


def fetch_mercadopago_payment(payment_id):
    access_token = get_mercadopago_access_token()
    if not access_token:
        return None
    status, payload = http_json(
        "GET",
        f"{mercadopago_base_url()}/v1/payments/{payment_id}",
        headers={"Authorization": f"Bearer {access_token}"},
    )
    if status != 200:
        return None
    return payload


def get_checkout_order(reference, transaction_id=None):
    order = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not order:
        return response(404, {"error": "order_not_found"})
    provider = order.get("provider", "wompi")
    current_status = order.get("status", "")
    if current_status in ("CHECKOUT_CREATED", "PENDING"):
        if provider == "mercadopago":
            payment = fetch_mercadopago_payment(transaction_id) if transaction_id else None
            if payment and payment.get("external_reference") == reference:
                order = update_order_from_mercadopago_payment(reference, payment) or order
        elif provider == "nequi":
            stored_tx = ((order.get("providerData") or {}).get("nequi") or {}).get("transactionId", "")
            order = update_order_from_nequi(reference, transaction_id or stored_tx) or order
        else:
            transaction = fetch_wompi_transaction(transaction_id) if transaction_id else None
            if transaction and transaction.get("reference") == reference:
                order = update_order_from_transaction(reference, transaction) or order
    # Strip PII — public tracking endpoint only returns non-sensitive fields
    public_order = {
        "reference": order.get("reference"),
        "status": order.get("status"),
        "fulfillmentStatus": order.get("fulfillmentStatus"),
        "trackingNumber": order.get("trackingNumber"),
        "courier": order.get("courier"),
        "provider": order.get("provider"),
        "createdAt": order.get("createdAt"),
        "updatedAt": order.get("updatedAt"),
        "items": [
            {
                "name": i.get("name"),
                "quantity": i.get("quantity"),
                "price": i.get("price"),
                "imageUrl": i.get("imageUrl", ""),
                "unitPriceCents": i.get("unitPriceCents", 0),
                "subtotalCents": i.get("subtotalCents", 0),
            }
            for i in (order.get("items") or [])
        ],
    }
    return response(200, {"ok": True, "order": public_order})


def get_nested(data, path):
    current = data
    for part in path.split("."):
        if not isinstance(current, dict):
            return ""
        current = current.get(part)
    return "" if current is None else str(current)


def verify_wompi_event_signature(event_payload, checksum_header):
    signature = event_payload.get("signature") or {}
    properties = signature.get("properties") or []
    timestamp = event_payload.get("timestamp", signature.get("timestamp"))
    expected_checksum = checksum_header or signature.get("checksum") or ""
    secret = get_wompi_events_secret()
    if not properties or timestamp is None or not expected_checksum or not secret:
        print(json.dumps({
            "event": "wompi_webhook_signature_missing_data",
            "hasProperties": bool(properties),
            "hasTimestamp": timestamp is not None,
            "hasChecksum": bool(expected_checksum),
            "hasSecret": bool(secret),
        }))
        return False
    base = "".join(get_nested(event_payload.get("data") or {}, path) for path in properties)
    calculated = hashlib.sha256(f"{base}{timestamp}{secret}".encode("utf-8")).hexdigest().upper()
    is_valid = calculated == expected_checksum.upper()
    if not is_valid:
        print(json.dumps({
            "event": "wompi_webhook_invalid_signature",
            "properties": properties,
            "timestamp": timestamp,
            "expectedPrefix": expected_checksum[:8],
            "calculatedPrefix": calculated[:8],
        }))
    return is_valid


def handle_wompi_webhook(event):
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    headers = event.get("headers", {}) or {}
    checksum_header = headers.get("x-event-checksum") or headers.get("X-Event-Checksum") or ""
    if get_wompi_events_secret() and not verify_wompi_event_signature(body, checksum_header):
        return response(401, {"error": "invalid_signature"})
    if body.get("event") != "transaction.updated":
        return response(200, {"ok": True, "ignored": True})
    transaction = (body.get("data") or {}).get("transaction") or {}
    reference = transaction.get("reference", "")
    print(json.dumps({
        "event": "wompi_webhook_received",
        "wompiEvent": body.get("event"),
        "reference": reference,
        "status": transaction.get("status", ""),
        "transactionId": transaction.get("id", ""),
    }))
    if not reference:
        return response(400, {"error": "missing_reference"})
    existing = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not existing:
        return response(200, {"ok": True, "ignored": True})
    verified, provider_transaction, reason = verify_wompi_transaction_with_provider(transaction)
    if not verified:
        status_code = 503 if reason == "provider_lookup_failed" else 200
        return response(status_code, {"ok": False, "error": reason})
    updated = update_order_from_transaction(reference, provider_transaction)
    return response(200, {"ok": True, "order": updated})


def verify_mercadopago_signature(event):
    secret = get_mercadopago_webhook_secret()
    if not secret:
        return True
    headers = event.get("headers", {}) or {}
    x_signature = headers.get("x-signature") or headers.get("X-Signature") or ""
    x_request_id = headers.get("x-request-id") or headers.get("X-Request-Id") or ""
    query = event.get("queryStringParameters") or {}
    data_id = (query.get("data.id") or "").lower()
    if not x_signature or not x_request_id or not data_id:
        return False
    ts = ""
    v1 = ""
    for part in x_signature.split(","):
        key, _, value = part.partition("=")
        key = key.strip()
        value = value.strip()
        if key == "ts":
            ts = value
        elif key == "v1":
            v1 = value
    if not ts or not v1:
        return False
    manifest = f"id:{data_id};request-id:{x_request_id};ts:{ts};"
    expected = hmac.new(secret.encode(), manifest.encode(), hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, v1)


def handle_nequi_webhook(event):
    """Receive Nequi payment status notification and update the order."""
    if not verify_nequi_webhook_signature(event):
        return response(401, {"error": "invalid_signature"})
    try:
        body = get_json_body(event) or {}
        status_data = extract_nequi_payment_status(body)
        reference = status_data.get("reference", "")
        tx_id = status_data.get("transactionId", "")
        if not reference:
            return response(400, {"error": "missing_reference"})
        existing = orders_table.get_item(Key={"reference": reference}).get("Item")
        if not existing:
            return response(200, {"ok": True, "ignored": True})
        updated = update_order_from_nequi(reference, tx_id, status_payload=body)
        return response(200, {"ok": True, "order": updated})
    except Exception as e:
        return response(500, {"error": str(e)})


def handle_mercadopago_webhook(event):
    if not verify_mercadopago_signature(event):
        return response(401, {"error": "invalid_signature"})
    query = event.get("queryStringParameters") or {}
    notification_type = (query.get("type") or query.get("topic") or "").lower()
    payment_id = query.get("data.id") or query.get("id") or ""
    if notification_type != "payment" or not payment_id:
        return response(200, {"ok": True, "ignored": True})
    payment = fetch_mercadopago_payment(payment_id)
    if not payment:
        return response(200, {"ok": True, "ignored": True})
    reference = payment.get("external_reference", "")
    if not reference:
        return response(200, {"ok": True, "ignored": True})
    existing = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not existing:
        return response(200, {"ok": True, "ignored": True})
    updated = update_order_from_mercadopago_payment(reference, payment)
    return response(200, {"ok": True, "order": updated})


# Auto-seed on cold start (once per Lambda container lifecycle)
def handler(event, context):
    # Out-of-band async task (self-invoked) for post-payment side effects so the
    # payment webhook can return 200 within the provider's timeout window.
    if isinstance(event, dict) and event.get("_task") == "post_payment_side_effects":
        reference = event.get("reference", "")
        order = orders_table.get_item(Key={"reference": reference}).get("Item") if reference else None
        if order:
            ensure_post_payment_side_effects(order)
        return {"ok": True}

    if isinstance(event, dict) and event.get("_task") == "send_test_email":
        return send_internal_test_email(event.get("recipient", ""))

    method = event.get("requestContext", {}).get("http", {}).get("method", "")
    path = event.get("rawPath", "").rstrip("/")
    body = event.get("body")

    if method == "GET" and path == "/api/health":
        return response(200, {"ok": True, "service": "sales-api"})

    if method == "GET" and path == "/api/products":
        return list_public_products()

    if method == "GET" and path == "/api/site-settings":
        return get_site_settings()

    # --- API Key protected POST endpoints (frontend sends x-api-key) ---
    if method == "POST" and path in ("/api/leads", "/api/checkout/session"):
        if not require_api_key(event):
            return response(401, {"error": "unauthorized", "message": "API key inválida o faltante."})

    if method == "POST" and path == "/api/leads":
        try:
            data = json.loads(body or "{}")
        except json.JSONDecodeError:
            return response(400, {"error": "invalid_json"})
        name = (data.get("name") or "").strip()
        email = (data.get("email") or "").strip().lower()
        message = (data.get("message") or "").strip()
        if not name or not email:
            return response(400, {"error": "name_and_email_required"})
        item = {
            "id": str(uuid.uuid4()),
            "name": name,
            "email": email,
            "message": message,
            "contacted": False,
            "createdAt": now_iso(),
        }
        leads_table.put_item(Item=item)
        return response(201, {"ok": True, "leadId": item["id"]})

    if method == "POST" and path == "/api/checkout/session":
        return create_checkout_session(event)

    if method == "POST" and path == "/api/webhooks/wompi":
        return handle_wompi_webhook(event)

    if method == "POST" and path == "/api/webhooks/mercadopago":
        return handle_mercadopago_webhook(event)

    if method == "POST" and path == "/api/webhooks/nequi":
        return handle_nequi_webhook(event)

    # --- Public order tracking (no auth — by reference) ---
    if path.startswith("/api/checkout/orders/") and method == "GET":
        reference = path.replace("/api/checkout/orders/", "").split("/")[0]
        if not reference:
            return response(400, {"error": "missing_reference"})
        query = event.get("queryStringParameters") or {}
        transaction_id = (query.get("transactionId") or query.get("id") or "").strip()
        return get_checkout_order(reference, transaction_id=transaction_id or None)

    if path.startswith("/api/admin"):
        if method == "POST" and path == "/api/admin/login":
            return handle_login(event)
        user = admin_auth_required(event)
        if not user:
            return response(401, {"error": "unauthorized"})

    if path == "/api/admin/products":
        if method == "GET":
            return list_products()
        if method == "POST":
            return create_product(get_json_body(event))

    if path == "/api/admin/site-settings":
        if method == "GET":
            return get_site_settings()
        if method == "PUT":
            return update_site_settings(get_json_body(event))

    if path.startswith("/api/admin/products/"):
        product_id = path.replace("/api/admin/products/", "").split("/")[0]
        if not product_id:
            return response(400, {"error": "missing_product_id"})
        if method == "PUT":
            return update_product(product_id, get_json_body(event))
        if method == "DELETE":
            return delete_product(product_id)

    if path == "/api/admin/dashboard" and method == "GET":
        return handle_dashboard()

    if path == "/api/admin/campaigns/send" and method == "POST":
        return send_campaign(get_json_body(event))

    if path == "/api/admin/leads" and method == "GET":
        return list_leads()

    if path.startswith("/api/admin/leads/") and method == "PUT":
        lead_id = path.replace("/api/admin/leads/", "").split("/")[0]
        if not lead_id:
            return response(400, {"error": "missing_lead_id"})
        return update_lead(lead_id, get_json_body(event))

    if path == "/api/admin/quotes" and method == "GET":
        return list_quotes()

    if path.startswith("/api/admin/quotes/") and method == "PUT":
        quote_id = path.replace("/api/admin/quotes/", "").split("/")[0]
        if not quote_id:
            return response(400, {"error": "missing_quote_id"})
        return update_quote(quote_id, get_json_body(event))

    if path == "/api/admin/orders" and method == "GET":
        return list_orders()

    if path.startswith("/api/admin/orders/") and method == "PUT":
        reference = path.replace("/api/admin/orders/", "").split("/")[0]
        if not reference:
            return response(400, {"error": "missing_reference"})
        return update_order_admin(reference, get_json_body(event))


    return response(404, {"error": "not_found"})

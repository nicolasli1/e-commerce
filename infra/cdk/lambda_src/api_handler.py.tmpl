    attr_vals = {f":v{k}": v for k, v in updates.items()}
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression=update_expr,
        ExpressionAttributeNames=attr_names,
        ExpressionAttributeValues=attr_vals,
        ReturnValues="ALL_NEW",
    )
    updated = orders_table.get_item(Key={"reference": reference}).get("Item")
    updated = sync_order_notifications(updated, previous_order=existing)
    return response(200, {"ok": True, "order": updated})


def get_origin(event):
    """
    Determine the public-facing origin URL for redirects and MP back_urls.
    Uses FRONTEND_URL env var when set (preferred), otherwise falls back to request headers.
    """
    if FRONTEND_URL:
        return FRONTEND_URL
    headers = event.get("headers", {}) or {}
    origin = headers.get("origin") or headers.get("Origin") or ""
    if origin:
        return origin.rstrip("/")
    referer = headers.get("referer") or headers.get("Referer") or ""
    if referer:
        parsed = urllib.parse.urlsplit(referer)
        if parsed.scheme and parsed.netloc:
            return f"{parsed.scheme}://{parsed.netloc}"
    proto = headers.get("x-forwarded-proto") or headers.get("X-Forwarded-Proto") or "https"
    host = headers.get("x-forwarded-host") or headers.get("X-Forwarded-Host") or headers.get("host") or headers.get("Host")
    if not host:
        return ""
    return f"{proto}://{host}"


def generate_order_reference():
    return f"NXC-{int(time.time())}-{uuid.uuid4().hex[:8].upper()}"


def build_integrity_signature(reference, amount_in_cents, currency, expiration_time=None):
    secret = get_wompi_integrity_secret()
    if not secret:
        raise ValueError("wompi_not_configured")
    pieces = [reference, str(amount_in_cents), currency]
    if expiration_time:
        pieces.append(expiration_time)
    pieces.append(secret)
    payload = "".join(pieces).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_order_items(cart_items):
    if not isinstance(cart_items, list) or not cart_items:
        raise ValueError("empty_cart")
    built = []
    total = 0
    for raw in cart_items:
        product_id = (raw.get("productId") or "").strip()
        quantity = max(1, safe_int(raw.get("quantity"), 1))
        if not product_id:
            raise ValueError("invalid_product")
        product = products_table.get_item(Key={"productId": product_id}).get("Item")
        if not product or product.get("status", "active") == "deleted":
            raise ValueError(f"product_not_found:{product_id}")
        # Internal convention: prices stored in DB as COP (e.g. 39000 = $39,000).
        # We multiply by 100 for the internal "cents" format (compatible with Wompi).
        # Mercado Pago receives pesos (÷100 back) via cents_to_cop_units() in build_mercadopago_preference().
        # Any new gateway consumer must understand: display = amountInCents / 100.
        unit_price_cents = int(Decimal(str(product.get("price", 0))) * 100)
        subtotal_cents = unit_price_cents * quantity
        total += subtotal_cents
        built.append({
            "productId": product_id,
            "name": product.get("name", ""),
            "category": product.get("category", "general"),
            "imageUrl": product.get("imageUrl", ""),
            "quantity": quantity,
            "unitPriceCents": unit_price_cents,
            "subtotalCents": subtotal_cents,
        })
    return built, total


def build_order_summary_lines(order):
    lines = []
    for item in order.get("items", []):
        lines.append(
            f"- {item.get('name', 'Producto')} x{item.get('quantity', 1)} · {cents_to_cop_text(item.get('subtotalCents', 0))}"
        )
    return "\n".join(lines) if lines else "- Sin items"


def capture_notification_result(notifications, key, result):
    entry = dict(notifications.get(key) or {})
    if result.get("ok"):
        entry["sentAt"] = now_iso()
        entry["lastAttemptAt"] = entry["sentAt"]
        entry["status"] = "SENT"
        entry["messageId"] = result.get("messageId", "")
        entry.pop("error", None)
    else:
        entry["lastAttemptAt"] = now_iso()
        entry["status"] = "FAILED"
        entry["error"] = result.get("error", "unknown_error")
    notifications[key] = entry


def send_email(recipient, subject, text_body, html_body):
    sender = get_order_notifications_from_email()
    if not sender or not recipient:
        return {
            "ok": False,
            "error": "missing_sender_or_recipient",
        }
    try:
        result = ses.send_email(
            FromEmailAddress=sender,
            Destination={"ToAddresses": [recipient]},
            Content={
                "Simple": {
                    "Subject": {"Data": subject, "Charset": "UTF-8"},
                    "Body": {
                        "Text": {"Data": text_body, "Charset": "UTF-8"},
                        "Html": {"Data": html_body, "Charset": "UTF-8"},
                    },
                }
            },
        )
        return {
            "ok": True,
            "messageId": result.get("MessageId", ""),
        }
    except Exception as exc:
        print(f"SES send_email failed for {recipient}: {exc}")
        return {
            "ok": False,
            "error": str(exc),
        }



def verify_nequi_webhook_signature(event):
    """Verify Nequi webhook using shared secret in Authorization header.
    Configure the same secret in Nequi Conecta portal as the webhook auth token.
    """
    secret = get_nequi_webhook_secret()
    if not secret:
        # If no secret configured, block all Nequi webhooks to fail safe
        return False
    headers = event.get("headers") or {}
    auth = headers.get("authorization") or headers.get("Authorization") or ""
    # Support both "Bearer <secret>" and raw secret
    token = auth.replace("Bearer ", "").strip()
    return hmac.compare_digest(token, secret)



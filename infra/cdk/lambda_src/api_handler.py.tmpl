def normalize_nequi_phone(phone_number):
    digits = "".join(ch for ch in str(phone_number or "") if ch.isdigit())
    if digits.startswith("57") and len(digits) == 12:
        digits = digits[2:]
    return digits if len(digits) == 10 and digits.startswith("3") else ""


def map_nequi_status(raw_status="", response_code=""):
    raw_status = str(raw_status or "").strip()
    response_code = str(response_code or "").strip()
    if raw_status == "35" or response_code == "00":
        return "APPROVED"
    if raw_status in ("33", "") and response_code in ("", "0", "AC", "PD"):
        return "PENDING"
    if raw_status in ("10-455", "10-454", "71"):
        return "DECLINED"
    if response_code in ("AC", "PD"):
        return "PENDING"
    return "DECLINED" if response_code else "PENDING"


def nequi_status_message(status, raw_status="", response_code=""):
    if status == "APPROVED":
        return "Pago aprobado por Nequi"
    if status == "DECLINED":
        return "Pago rechazado o cancelado en Nequi"
    if raw_status or response_code:
        return "Pago pendiente de confirmación en Nequi"
    return "Esperando aprobación desde la app Nequi"


def extract_nequi_payment_status(payload):
    response_message = (payload or {}).get("ResponseMessage") or {}
    response_header = response_message.get("ResponseHeader") or {}
    response_body = ((response_message.get("ResponseBody") or {}).get("any") or {})
    payment_body = (
        response_body.get("pushPaymentRS")
        or response_body.get("unregisteredPaymentRS")
        or response_body.get("getStatusPaymentRS")
        or {}
    )
    raw_status = payment_body.get("status", "")
    response_code = (
        response_header.get("ResponseCode")
        or (response_header.get("Status") or {}).get("StatusCode", "")
    )
    status = map_nequi_status(raw_status, response_code)
    return {
        "status": status,
        "statusMessage": nequi_status_message(status, raw_status, response_code),
        "rawStatus": raw_status,
        "responseCode": response_code,
        "reference": payment_body.get("code") or payment_body.get("reference2") or payment_body.get("reference3") or "",
        "transactionId": payment_body.get("transactionId") or payment_body.get("codeQR") or "",
    }



def normalize_site_settings(body):
    body = body if isinstance(body, dict) else {}
    theme = (body.get("visualTheme") or DEFAULT_SITE_SETTINGS["visualTheme"]).strip()
    if theme not in ("dark", "repair"):
        theme = DEFAULT_SITE_SETTINGS["visualTheme"]
    return {
        "visualTheme": theme,
    }


def cents_to_cop_units(amount_in_cents):
    return int(
        (Decimal(str(amount_in_cents)) / Decimal("100")).quantize(
            Decimal("1"),
            rounding=ROUND_HALF_UP,
        )
    )


def cents_to_cop_text(amount_in_cents):
    return f"${cents_to_cop_units(amount_in_cents):,}".replace(",", ".") + " COP"



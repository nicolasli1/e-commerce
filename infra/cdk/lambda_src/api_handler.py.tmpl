def order_shipping_lines(order):
    customer = order.get("customer") or {}
    shipping = order.get("shippingAddress") or {}
    if not isinstance(shipping, dict):
        return []
    lines = [
        shipping.get("name") or customer.get("fullName", ""),
        shipping.get("addressLine1", ""),
        shipping.get("addressLine2", ""),
        ", ".join(part for part in [shipping.get("city", ""), shipping.get("region", "")] if part),
        shipping.get("country", ""),
        shipping.get("phoneNumber", ""),
    ]
    return [line for line in lines if line]



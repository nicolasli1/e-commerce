def email_status_rail(active_step):
    steps = [
        ("paid", "Pago recibido"),
        ("preparing", "Preparación"),
        ("shipped", "En camino"),
        ("delivered", "Entregado"),
    ]
    active_index = next((idx for idx, (key, _) in enumerate(steps) if key == active_step), 0)
    cells = []
    for idx, (_, label) in enumerate(steps):
        done = idx <= active_index
        dot_color = "#0f766e" if done else "#d0d5dd"
        text_color = "#101828" if done else "#98a2b3"
        cells.append(
            "<td align='center' style='padding:0 4px;'>"
            f"<div style='width:14px;height:14px;border-radius:999px;background:{dot_color};margin:0 auto 8px;'></div>"
            f"<div style='font-size:11px;font-weight:700;color:{text_color};line-height:1.25;'>{label}</div>"
            "</td>"
        )
    return (
        "<table role='presentation' width='100%' cellspacing='0' cellpadding='0' style='margin:24px 0 4px;'>"
        f"<tr>{''.join(cells)}</tr>"
        "</table>"
    )



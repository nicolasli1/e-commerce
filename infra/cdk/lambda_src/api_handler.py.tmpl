def _hash_password(password: str) -> str:
    """Hash password with PBKDF2-HMAC-SHA256 + random salt.
    Format: pbkdf2:sha256:{iterations}:{hex_salt}:{hex_hash}
    """
    import os as _os
    salt = _os.urandom(16).hex()
    iterations = 260000
    dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), iterations)
    return f"pbkdf2:sha256:{iterations}:{salt}:{dk.hex()}"


def _verify_password(password: str, stored: str) -> bool:
    """Verify password against stored PBKDF2 hash.
    Falls back to legacy SHA-256 for existing hashes during migration.
    """
    if not stored:
        return False
    if stored.startswith("pbkdf2:sha256:"):
        try:
            _, _, iters, salt, stored_hash = stored.split(":", 4)
            dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), int(iters))
            return hmac.compare_digest(dk.hex(), stored_hash)
        except Exception:
            return False
    # Legacy SHA-256 fallback (migration path — remove after all users re-hash)
    return hmac.compare_digest(hashlib.sha256(password.encode()).hexdigest(), stored)


def get_parameter(name, decrypt=False):
    if not name:
        return ""
    cache_key = (name, decrypt)
    if cache_key in _param_cache:
        return _param_cache[cache_key]
    result = ssm.get_parameter(Name=name, WithDecryption=decrypt)
    value = result["Parameter"]["Value"]
    _param_cache[cache_key] = value
    return value



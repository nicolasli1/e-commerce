def images_to_url(images, fallback_url=''):
    """Convert images array to frontend-friendly format.
    Returns an object {lg, md, sm} if images exist, or the fallback URL string."""
    if images and isinstance(images, list) and len(images) > 0:
        img = images[0]
        if isinstance(img, dict):
            return {
                "lg": img.get("lg", fallback_url),
                "md": img.get("md", fallback_url),
                "sm": img.get("sm", fallback_url),
            }
    return fallback_url

def _parse_variants(variants_raw):
    """Validate and normalise a list of variant maps from the request body."""
    if not isinstance(variants_raw, list):
        return []
    parsed = []
    for v in variants_raw:
        if not isinstance(v, dict):
            continue
        variant_id = (v.get("variantId") or str(uuid.uuid4())).strip()
        raw_price = v.get("price")
        raw_stock = v.get("stock")
        try:
            price = Decimal(str(raw_price)) if raw_price not in (None, "") else None
        except Exception:
            price = None
        try:
            stock = int(raw_stock) if raw_stock not in (None, "") else None
        except Exception:
            stock = None
        # Parse variant images
        images_raw = v.get("images") or []
        images_parsed = []
        for img in images_raw:
            if isinstance(img, dict) and img.get("lg"):
                images_parsed.append({"lg": img["lg"], "md": img.get("md", ""), "sm": img.get("sm", "")})
        parsed.append({
            "variantId": variant_id,
            "deviceBrand": (v.get("deviceBrand") or "").strip(),
            "deviceFamily": (v.get("deviceFamily") or "").strip(),
            "model": (v.get("model") or "").strip(),
            "price": price,
            "stock": stock,
            "quality": (v.get("quality") or "").strip(),
            "images": images_parsed,
        })
    return parsed


def _extract_device_families(variants_raw):
    """Return a deduplicated list of deviceFamily strings from variants."""
    if not isinstance(variants_raw, list):
        return []
    seen = set()
    families = []
    for v in variants_raw:
        if not isinstance(v, dict):
            continue
        fam = (v.get("deviceFamily") or "").strip()
        if fam and fam not in seen:
            seen.add(fam)
            families.append(fam)
    return families


def _derive_product_fields_from_variants(variants):
    """Return product-level price, stock and quality defaults from variants."""
    prices = [
        v.get("price")
        for v in variants
        if isinstance(v, dict) and v.get("price") is not None and v.get("price") > 0
    ]
    stocks = [
        int(v.get("stock") or 0)
        for v in variants
        if isinstance(v, dict) and v.get("stock") is not None
    ]
    qualities = [
        (v.get("quality") or "").strip()
        for v in variants
        if isinstance(v, dict) and (v.get("quality") or "").strip()
    ]
    unique_qualities = list(dict.fromkeys(qualities))
    return {
        "price": min(prices) if prices else None,
        "stock": sum(stocks) if stocks else 0,
        "quality": unique_qualities[0] if len(unique_qualities) == 1 else "",
    }


def _parse_price(value):
    if value in (None, ""):
        return None
    try:
        return Decimal(str(value))
    except Exception:
        return None



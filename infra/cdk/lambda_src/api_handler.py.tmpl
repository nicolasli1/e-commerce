def get_origin(event):
    headers = event.get("headers", {}) or {}
    origin = headers.get("origin") or headers.get("Origin") or ""
    if origin:
        return origin.rstrip("/")
    referer = headers.get("referer") or headers.get("Referer") or ""
    if referer:
        parsed = urllib.parse.urlsplit(referer)
        if parsed.scheme and parsed.netloc:
            return f"{parsed.scheme}://{parsed.netloc}"
    proto = headers.get("x-forwarded-proto") or headers.get("X-Forwarded-Proto") or "https"
    host = headers.get("x-forwarded-host") or headers.get("X-Forwarded-Host") or headers.get("host") or headers.get("Host")
    if not host:
        return ""
    return f"{proto}://{host}"


def generate_order_reference():
    return f"NXC-{int(time.time())}-{uuid.uuid4().hex[:8].upper()}"


def build_integrity_signature(reference, amount_in_cents, currency, expiration_time=None):
    secret = get_wompi_integrity_secret()
    if not secret:
        raise ValueError("wompi_not_configured")
    pieces = [reference, str(amount_in_cents), currency]
    if expiration_time:
        pieces.append(expiration_time)
    pieces.append(secret)
    payload = "".join(pieces).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_order_items(cart_items):
    if not isinstance(cart_items, list) or not cart_items:
        raise ValueError("empty_cart")
    built = []
    total = 0
    for raw in cart_items:
        product_id = (raw.get("productId") or "").strip()
        quantity = max(1, safe_int(raw.get("quantity"), 1))
        if not product_id:
            raise ValueError("invalid_product")
        product = products_table.get_item(Key={"productId": product_id}).get("Item")
        if not product or product.get("status", "active") == "deleted":
            raise ValueError(f"product_not_found:{product_id}")
        unit_price_cents = int(Decimal(str(product.get("price", 0))) * 100)
        subtotal_cents = unit_price_cents * quantity
        total += subtotal_cents
        built.append({
            "productId": product_id,
            "name": product.get("name", ""),
            "category": product.get("category", "general"),
            "quantity": quantity,
            "unitPriceCents": unit_price_cents,
            "subtotalCents": subtotal_cents,
        })
    return built, total


def normalize_customer(body):
    customer = body.get("customer") or {}
    full_name = (customer.get("fullName") or "").strip()
    email = (customer.get("email") or "").strip().lower()
    phone_number = (customer.get("phoneNumber") or "").strip()
    phone_prefix = (customer.get("phoneNumberPrefix") or "+57").strip()
    legal_id = (customer.get("legalId") or "").strip()
    legal_id_type = (customer.get("legalIdType") or "").strip()
    if not full_name or not email:
        raise ValueError("name_and_email_required")
    return {
        "fullName": full_name,
        "email": email,
        "phoneNumber": phone_number,
        "phoneNumberPrefix": phone_prefix,
        "legalId": legal_id,
        "legalIdType": legal_id_type,
    }


def normalize_shipping(body):
    shipping = body.get("shippingAddress") or {}
    normalized = {
        "addressLine1": (shipping.get("addressLine1") or "").strip(),
        "addressLine2": (shipping.get("addressLine2") or "").strip(),
        "country": (shipping.get("country") or "CO").strip().upper(),
        "city": (shipping.get("city") or "").strip(),
        "phoneNumber": (shipping.get("phoneNumber") or "").strip(),
        "region": (shipping.get("region") or "").strip(),
        "name": (shipping.get("name") or "").strip(),
    }
    required = ["addressLine1", "country", "city", "phoneNumber", "region"]
    if any(normalized[field] for field in normalized):
        if all(normalized[field] for field in required):
            return normalized
    return None


def build_widget_config(reference, amount_in_cents, customer, shipping, redirect_url):
    expiration_time = (datetime.now(timezone.utc) + timedelta(minutes=30)).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    signature = build_integrity_signature(reference, amount_in_cents, "COP", expiration_time)
    config = {
        "publicKey": get_wompi_public_key(),
        "currency": "COP",
        "amountInCents": amount_in_cents,
        "reference": reference,
        "redirectUrl": redirect_url,
        "expirationTime": expiration_time,
        "signature": {"integrity": signature},
        "customerData": {
            "email": customer["email"],
            "fullName": customer["fullName"],
            "phoneNumber": customer["phoneNumber"],
            "phoneNumberPrefix": customer["phoneNumberPrefix"],
        },
    }
    if customer.get("legalId") and customer.get("legalIdType"):
        config["customerData"]["legalId"] = customer["legalId"]
        config["customerData"]["legalIdType"] = customer["legalIdType"]
        config["collectCustomerLegalId"] = True
    if shipping:
        config["shippingAddress"] = shipping
        config["collectShipping"] = True
    return config


def mercadopago_base_url():
    return "https://api.mercadopago.com"


def mercadopago_notification_url(origin):
    if not origin:
        return ""
    return f"{origin}/api/webhooks/mercadopago?source=webhooks"


def build_mercadopago_preference(reference, items, customer, shipping, origin):
    access_token = get_mercadopago_access_token()
    if not access_token:
        raise ValueError("mercadopago_not_configured")

    payload = {
        "external_reference": reference,
        "items": [{
            "id": item["productId"],
            "title": item["name"],
            "description": item["category"],
            "quantity": item["quantity"],
            "currency_id": "COP",
            "unit_price": cents_to_cop_units(item["unitPriceCents"]),
        } for item in items],
        "payer": {
            "name": customer.get("fullName", ""),
            "email": customer.get("email", ""),
        },
        "payment_methods": {
            "installments": 12,
        },
        "metadata": {
            "reference": reference,
            "integration": "nexcore-checkout",
        },
        "back_urls": {
            "success": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
            "failure": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
            "pending": f"{origin}/?checkout=return&provider=mercadopago&reference={urllib.parse.quote(reference)}" if origin else "",
        },
        "auto_return": "approved",
        "statement_descriptor": "NEXCORE",
    }
    if shipping:
        payload["shipments"] = {
            "receiver_address": {
                "zip_code": shipping.get("region", "000000"),
                "street_name": shipping.get("addressLine1", ""),
                "apartment": shipping.get("addressLine2", ""),
                "city_name": shipping.get("city", ""),
                "state_name": shipping.get("region", ""),
                "country_name": shipping.get("country", "CO"),
            }
        }
    notification_url = mercadopago_notification_url(origin)
    if notification_url:
        payload["notification_url"] = notification_url

    status, data = http_json(
        "POST",
        f"{mercadopago_base_url()}/checkout/preferences",
        headers={"Authorization": f"Bearer {access_token}"},
        body=payload,
    )
    if status not in (200, 201):
        message = (data.get("message") or data.get("error") or "mercadopago_preference_error")
        raise RuntimeError(message)
    return data


def map_mercadopago_status(status):
    mapping = {
        "approved": "APPROVED",
        "authorized": "APPROVED",
        "pending": "PENDING",
        "in_process": "PENDING",
        "in_mediation": "PENDING",
        "rejected": "DECLINED",
        "cancelled": "CANCELLED",
        "charged_back": "CHARGEDBACK",
        "refunded": "REFUNDED",
    }
    return mapping.get((status or "").lower(), (status or "PENDING").upper())


def create_checkout_session(event):
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    provider = (body.get("provider") or "wompi").strip().lower()
    if provider not in ("wompi", "mercadopago"):
        return response(400, {"error": "unsupported_provider"})
    if provider == "wompi" and not wompi_enabled():
        return response(503, {
            "error": "checkout_unavailable",
            "message": "Wompi no está configurado todavía en este entorno.",
        })
    if provider == "mercadopago" and not mercadopago_enabled():
        return response(503, {
            "error": "checkout_unavailable",
            "message": "Mercado Pago no está configurado todavía en este entorno.",
        })
    try:
        customer = normalize_customer(body)
        shipping = normalize_shipping(body)
        items, total_cents = build_order_items(body.get("cart") or [])
    except ValueError as exc:
        return response(400, {"error": str(exc)})

    reference = generate_order_reference()
    origin = get_origin(event)
    redirect_url = f"{origin}/?checkout=return&reference={urllib.parse.quote(reference)}" if origin else ""
    widget_config = None
    mercadopago_config = None
    provider_data = {"name": provider}
    if provider == "wompi":
        widget_config = build_widget_config(reference, total_cents, customer, shipping, redirect_url)
        provider_data["wompi"] = {
            "environment": "sandbox" if get_wompi_public_key().startswith("pub_test_") else "production",
            "transactionId": "",
        }
    else:
        preference = build_mercadopago_preference(reference, items, customer, shipping, origin)
        mercadopago_config = {
            "publicKey": get_mercadopago_public_key(),
            "preferenceId": preference.get("id", ""),
            "initPoint": preference.get("init_point", ""),
            "sandboxInitPoint": preference.get("sandbox_init_point", ""),
        }
        provider_data["mercadopago"] = {
            "preferenceId": preference.get("id", ""),
            "paymentId": "",
            "initPoint": preference.get("init_point", ""),
        }
    order = {
        "reference": reference,
        "orderId": str(uuid.uuid4()),
        "status": "CHECKOUT_CREATED",
        "statusMessage": "Checkout creado y listo para pago",
        "currency": "COP",
        "amountInCents": total_cents,
        "items": items,
        "customer": customer,
        "shippingAddress": shipping,
        "notes": (body.get("notes") or "").strip(),
        "redirectUrl": redirect_url,
        "provider": provider,
        "providerData": provider_data,
        "createdAt": now_iso(),
        "updatedAt": now_iso(),
    }
    orders_table.put_item(Item=order)
    payload = {
        "ok": True,
        "reference": reference,
        "order": order,
    }
    if widget_config:
        payload["wompi"] = widget_config
    if mercadopago_config:
        payload["mercadopago"] = mercadopago_config
    return response(201, payload)


def fetch_wompi_transaction(transaction_id):
    public_key = get_wompi_public_key()
    if not public_key:
        return None
    url = f"{wompi_base_url(public_key)}/transactions/{transaction_id}"
    status, payload = http_json(
        "GET",
        url,
        headers={"Authorization": f"Bearer {public_key}"},
    )
    if status != 200:
        return None
    return payload.get("data")


def update_order_from_transaction(reference, transaction):
    if not transaction:
        return None
    status = transaction.get("status", "PENDING")
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression="SET #status=:status, #statusMessage=:message, #updatedAt=:updatedAt, #wompi=:wompi",
        ExpressionAttributeNames={
            "#status": "status",
            "#statusMessage": "statusMessage",
            "#updatedAt": "updatedAt",
            "#wompi": "wompi",
        },
        ExpressionAttributeValues={
            ":status": status,
            ":message": transaction.get("status_message", status),
            ":updatedAt": now_iso(),
            ":wompi": {
                "environment": "sandbox" if get_wompi_public_key().startswith("pub_test_") else "production",
                "transactionId": transaction.get("id", ""),
                "paymentMethodType": transaction.get("payment_method_type", ""),
                "status": status,
            },
        },
    )
    return orders_table.get_item(Key={"reference": reference}).get("Item")


def update_order_from_mercadopago_payment(reference, payment):
    if not payment:
        return None
    mapped_status = map_mercadopago_status(payment.get("status"))
    current = orders_table.get_item(Key={"reference": reference}).get("Item") or {}
    provider_data = current.get("providerData", {})
    provider_data["mercadopago"] = {
        "paymentId": payment.get("id", ""),
        "status": payment.get("status", ""),
        "statusDetail": payment.get("status_detail", ""),
        "merchantOrderId": payment.get("order", {}).get("id", ""),
        "externalReference": payment.get("external_reference", ""),
    }
    orders_table.update_item(
        Key={"reference": reference},
        UpdateExpression="SET #status=:status, #statusMessage=:message, #updatedAt=:updatedAt, #providerData=:providerData",
        ExpressionAttributeNames={
            "#status": "status",
            "#statusMessage": "statusMessage",
            "#updatedAt": "updatedAt",
            "#providerData": "providerData",
        },
        ExpressionAttributeValues={
            ":status": mapped_status,
            ":message": payment.get("status_detail", payment.get("status", mapped_status)),
            ":updatedAt": now_iso(),
            ":providerData": provider_data,
        },
    )
    return orders_table.get_item(Key={"reference": reference}).get("Item")


def fetch_mercadopago_payment(payment_id):
    access_token = get_mercadopago_access_token()
    if not access_token:
        return None
    status, payload = http_json(
        "GET",
        f"{mercadopago_base_url()}/v1/payments/{payment_id}",
        headers={"Authorization": f"Bearer {access_token}"},
    )
    if status != 200:
        return None
    return payload


def get_checkout_order(reference, transaction_id=None):
    order = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not order:
        return response(404, {"error": "order_not_found"})
    provider = order.get("provider", "wompi")
    current_status = order.get("status", "")
    if transaction_id and current_status in ("CHECKOUT_CREATED", "PENDING"):
        if provider == "mercadopago":
            payment = fetch_mercadopago_payment(transaction_id)
            if payment and payment.get("external_reference") == reference:
                order = update_order_from_mercadopago_payment(reference, payment) or order
        else:
            transaction = fetch_wompi_transaction(transaction_id)
            if transaction and transaction.get("reference") == reference:
                order = update_order_from_transaction(reference, transaction) or order
    return response(200, {"ok": True, "order": order})


def get_nested(data, path):
    current = data
    for part in path.split("."):
        if not isinstance(current, dict):
            return ""
        current = current.get(part)
    return "" if current is None else str(current)


def verify_wompi_event_signature(event_payload, checksum_header):
    signature = event_payload.get("signature") or {}
    properties = signature.get("properties") or []
    timestamp = signature.get("timestamp")
    expected_checksum = checksum_header or signature.get("checksum") or ""
    secret = get_wompi_events_secret()
    if not properties or timestamp is None or not expected_checksum or not secret:
        return False
    base = "".join(get_nested(event_payload.get("data") or {}, path) for path in properties)
    calculated = hashlib.sha256(f"{base}{timestamp}{secret}".encode("utf-8")).hexdigest().upper()
    return calculated == expected_checksum.upper()


def handle_wompi_webhook(event):
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    headers = event.get("headers", {}) or {}
    checksum_header = headers.get("x-event-checksum") or headers.get("X-Event-Checksum") or ""
    if get_wompi_events_secret() and not verify_wompi_event_signature(body, checksum_header):
        return response(401, {"error": "invalid_signature"})
    if body.get("event") != "transaction.updated":
        return response(200, {"ok": True, "ignored": True})
    transaction = (body.get("data") or {}).get("transaction") or {}
    reference = transaction.get("reference", "")
    if not reference:
        return response(400, {"error": "missing_reference"})
    existing = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not existing:
        return response(200, {"ok": True, "ignored": True})
    updated = update_order_from_transaction(reference, transaction)
    return response(200, {"ok": True, "order": updated})


def verify_mercadopago_signature(event):
    secret = get_mercadopago_webhook_secret()
    if not secret:
        return True
    headers = event.get("headers", {}) or {}
    x_signature = headers.get("x-signature") or headers.get("X-Signature") or ""
    x_request_id = headers.get("x-request-id") or headers.get("X-Request-Id") or ""
    query = event.get("queryStringParameters") or {}
    data_id = (query.get("data.id") or "").lower()
    if not x_signature or not x_request_id or not data_id:
        return False
    ts = ""
    v1 = ""
    for part in x_signature.split(","):
        key, _, value = part.partition("=")
        key = key.strip()
        value = value.strip()
        if key == "ts":
            ts = value
        elif key == "v1":
            v1 = value
    if not ts or not v1:
        return False
    manifest = f"id:{data_id};request-id:{x_request_id};ts:{ts};"
    expected = hmac.new(secret.encode(), manifest.encode(), hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, v1)


def handle_mercadopago_webhook(event):
    if not verify_mercadopago_signature(event):
        return response(401, {"error": "invalid_signature"})
    query = event.get("queryStringParameters") or {}
    notification_type = (query.get("type") or query.get("topic") or "").lower()
    payment_id = query.get("data.id") or query.get("id") or ""
    if notification_type != "payment" or not payment_id:
        return response(200, {"ok": True, "ignored": True})
    payment = fetch_mercadopago_payment(payment_id)
    if not payment:
        return response(200, {"ok": True, "ignored": True})
    reference = payment.get("external_reference", "")
    if not reference:
        return response(200, {"ok": True, "ignored": True})
    existing = orders_table.get_item(Key={"reference": reference}).get("Item")
    if not existing:
        return response(200, {"ok": True, "ignored": True})
    updated = update_order_from_mercadopago_payment(reference, payment)
    return response(200, {"ok": True, "order": updated})


def handler(event, context):
    method = event.get("requestContext", {}).get("http", {}).get("method", "")
    path = event.get("rawPath", "").rstrip("/")
    body = event.get("body")

    if method == "GET" and path == "/api/health":
        return response(200, {"ok": True, "service": "sales-api"})

    if method == "GET" and path == "/api/products":
        return list_public_products()

    if method == "POST" and path == "/api/leads":
        try:
            data = json.loads(body or "{}")
        except json.JSONDecodeError:
            return response(400, {"error": "invalid_json"})
        name = (data.get("name") or "").strip()
        email = (data.get("email") or "").strip().lower()
        message = (data.get("message") or "").strip()
        if not name or not email:
            return response(400, {"error": "name_and_email_required"})
        item = {
            "id": str(uuid.uuid4()),
            "name": name,
            "email": email,
            "message": message,
            "contacted": False,
            "createdAt": now_iso(),
        }
        leads_table.put_item(Item=item)
        return response(201, {"ok": True, "leadId": item["id"]})

    if method == "POST" and path == "/api/checkout/session":
        return create_checkout_session(event)

    if method == "POST" and path == "/api/webhooks/wompi":
        return handle_wompi_webhook(event)

    if method == "POST" and path == "/api/webhooks/mercadopago":
        return handle_mercadopago_webhook(event)

    if path.startswith("/api/checkout/orders/") and method == "GET":
        reference = path.replace("/api/checkout/orders/", "").split("/")[0]
        if not reference:
            return response(400, {"error": "missing_reference"})
        query = event.get("queryStringParameters") or {}
        transaction_id = (query.get("transactionId") or query.get("id") or "").strip()
        return get_checkout_order(reference, transaction_id=transaction_id or None)

    if path.startswith("/api/admin"):
        if method == "POST" and path == "/api/admin/login":
            return handle_login(event)
        user = admin_auth_required(event)
        if not user:
            return response(401, {"error": "unauthorized"})

    if path == "/api/admin/products":
        if method == "GET":
            return list_products()
        if method == "POST":
            return create_product(get_json_body(event))

    if path.startswith("/api/admin/products/"):
        product_id = path.replace("/api/admin/products/", "").split("/")[0]
        if not product_id:
            return response(400, {"error": "missing_product_id"})
        if method == "PUT":
            return update_product(product_id, get_json_body(event))
        if method == "DELETE":
            return delete_product(product_id)

    if path == "/api/admin/dashboard" and method == "GET":
        return handle_dashboard()

    if path == "/api/admin/leads" and method == "GET":
        return list_leads()

    if path.startswith("/api/admin/leads/") and method == "PUT":
        lead_id = path.replace("/api/admin/leads/", "").split("/")[0]
        if not lead_id:
            return response(400, {"error": "missing_lead_id"})
        return update_lead(lead_id, get_json_body(event))

    if path == "/api/admin/quotes" and method == "GET":
        return list_quotes()

    if path.startswith("/api/admin/quotes/") and method == "PUT":
        quote_id = path.replace("/api/admin/quotes/", "").split("/")[0]
        if not quote_id:
            return response(400, {"error": "missing_quote_id"})
        return update_quote(quote_id, get_json_body(event))

    return response(404, {"error": "not_found"})

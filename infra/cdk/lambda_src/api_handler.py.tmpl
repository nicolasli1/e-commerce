def get_origin(event):
    """
    Determine the public-facing origin URL for redirects and MP back_urls.
    Always uses FRONTEND_URL env var when set.
    When not set, falls back to request headers but validates against an
    allowlist to prevent open-redirect attacks via attacker-controlled Origin.
    """
    if FRONTEND_URL:
        return FRONTEND_URL
    headers = event.get("headers", {}) or {}
    # Build candidate from headers
    proto = headers.get("x-forwarded-proto") or headers.get("X-Forwarded-Proto") or "https"
    host = headers.get("x-forwarded-host") or headers.get("X-Forwarded-Host") or headers.get("host") or headers.get("Host") or ""
    candidate = f"{proto}://{host}".rstrip("/") if host else ""
    # Only allow known storefront origins. If the request reaches Lambda through
    # an API Gateway host, fall back to the production storefront instead of
    # returning an empty redirect URL to payment providers.
    allowed = (
        candidate in ("https://repuestoscel.com", "https://www.repuestoscel.com")
        or candidate.endswith(".cloudfront.net")
        or candidate.startswith("http://localhost")
        or candidate.startswith("http://127.0.0.1")
    )
    return candidate if allowed else "https://repuestoscel.com"


def generate_order_reference():
    return f"NXC-{int(time.time())}-{uuid.uuid4().hex[:8].upper()}"


def build_integrity_signature(reference, amount_in_cents, currency, expiration_time=None):
    secret = get_wompi_integrity_secret()
    if not secret:
        raise ValueError("wompi_not_configured")
    pieces = [reference, str(amount_in_cents), currency]
    if expiration_time:
        pieces.append(expiration_time)
    pieces.append(secret)
    payload = "".join(pieces).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_order_items(cart_items):
    if not isinstance(cart_items, list) or not cart_items:
        raise ValueError("empty_cart")
    built = []
    total = 0
    for raw in cart_items:
        product_id = (raw.get("productId") or "").strip()
        variant_id = (raw.get("variantId") or "").strip()
        quantity = max(1, safe_int(raw.get("quantity"), 1))
        if not product_id:
            raise ValueError("invalid_product")
        product = products_table.get_item(Key={"productId": product_id}).get("Item")
        if not product or product.get("status", "active") == "deleted":
            raise ValueError(f"product_not_found:{product_id}")
        variants = product.get("variants") if isinstance(product.get("variants"), list) else []
        variant = None
        variant_label = ""
        if variants:
            if not variant_id:
                raise ValueError(f"variant_required:{product_id}")
            variant = next((v for v in variants if (v.get("variantId") or "") == variant_id), None)
            if not variant:
                raise ValueError(f"variant_not_found:{product_id}:{variant_id}")
            variant_stock = safe_int(variant.get("stock"), 0)
            if variant_stock < quantity:
                raise ValueError(f"out_of_stock:{product_id}:{variant_id}")
            variant_parts = [variant.get("deviceFamily", ""), variant.get("model", "")]
            variant_label = " ".join(part.strip() for part in variant_parts if str(part).strip())
        else:
            stock = safe_int(product.get("stock"), 0)
            if stock < quantity:
                raise ValueError(f"out_of_stock:{product_id}")
        # Internal convention: prices stored in DB as COP (e.g. 39000 = $39,000).
        # We multiply by 100 for the internal "cents" format (compatible with Wompi).
        # Mercado Pago receives pesos (÷100 back) via cents_to_cop_units() in build_mercadopago_preference().
        # Any new gateway consumer must understand: display = amountInCents / 100.
        unit_price = variant.get("price") if variant else product.get("price", 0)
        image_url = product.get("imageUrl", "")
        if variant and isinstance(variant.get("images"), list) and variant.get("images"):
            image_url = images_to_url(variant.get("images"), image_url)
        unit_price_cents = int(Decimal(str(unit_price or 0)) * 100)
        subtotal_cents = unit_price_cents * quantity
        total += subtotal_cents
        built.append({
            "productId": product_id,
            "variantId": variant_id,
            "variantLabel": variant_label,
            "name": product.get("name", ""),
            "category": product.get("category", "general"),
            "imageUrl": image_url,
            "quantity": quantity,
            "unitPriceCents": unit_price_cents,
            "subtotalCents": subtotal_cents,
        })
    return built, total



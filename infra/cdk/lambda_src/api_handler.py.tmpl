class DecimalEncoder(json.JSONEncoder):
    def default(self, obj):
        from decimal import Decimal as _Decimal
        if isinstance(obj, _Decimal):
            return float(obj)
        return super().default(obj)


def response(status_code, body, extra_headers=None):
    headers = {"Content-Type": "application/json"}
    if extra_headers:
        headers.update(extra_headers)
    return {
        "statusCode": status_code,
        "headers": headers,
        "body": json.dumps(body, cls=DecimalEncoder),
    }


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def slugify(value):
    cleaned = "".join(ch.lower() if ch.isalnum() else "-" for ch in (value or "").strip())
    while "--" in cleaned:
        cleaned = cleaned.replace("--", "-")
    return cleaned.strip("-")


def normalize_category(value):
    category = slugify(value or "")
    return category if category in PRODUCT_CATEGORIES else "herramientas-diy"


def is_site_settings_item(item):

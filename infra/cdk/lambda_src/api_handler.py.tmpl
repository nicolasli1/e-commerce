def _nequi_token_base():
    return "https://oauth.sandbox.nequi.com" if _nequi_is_sandbox() else "https://oauth.nequi.com"

def _nequi_api_base():
    return "https://api.sandbox.nequi.com" if _nequi_is_sandbox() else "https://api.nequi.com"

def get_nequi_token():
    """Exchange client credentials for Nequi OAuth2 access token.
    Source: developer.nequi.com.co/integrate-con-nequi → Token de Seguridad
    POST /token  |  Authorization: Basic base64(client_id:client_secret)
    grant_type as query param + body (compatible with both interpretations)
    """
    import base64 as _b64
    client_id = get_nequi_client_id()
    client_secret = get_nequi_client_secret()
    credentials = _b64.b64encode(f"{client_id}:{client_secret}".encode()).decode()
    url = f"{_nequi_token_base()}/token?grant_type=client_credentials"
    resp = urllib_request(
        url,
        method="POST",
        headers={
            "Authorization": f"Basic {credentials}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        body=b"grant_type=client_credentials",
    )
    return (resp.get("access_token") or "") if isinstance(resp, dict) else ""


def initiate_nequi_push_payment(phone_number, amount_cop, reference):
    """
    Push a payment notification to the customer's Nequi app.
    Source: docs.conecta.nequi.com.co → Pagos con notificación Push
    Endpoint: POST /payments/v2/-services-paymentservice-unregisteredpayment
    Returns (success: bool, transaction_id: str, error: str)
    """
    import uuid, datetime
    api_key = get_nequi_api_key()
    token = get_nequi_token()
    if not token:
        return False, "", "nequi_token_error"

    message_id = str(uuid.uuid4()).replace("-", "")[:10].upper()
    now = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=-5)))
    request_date = now.strftime("%Y-%m-%dT%H:%M:%S.000-05:00")
    clean_phone = normalize_nequi_phone(phone_number)
    if not clean_phone:
        return False, "", "nequi_invalid_phone"

    payload = {
        "RequestMessage": {
            "RequestHeader": {
                "Channel": "PNP04-C001",
                "RequestDate": request_date,
                "MessageID": message_id,
                "ClientID": get_nequi_client_id(),
                "Destination": {
                    "ServiceName": "PaymentsService",
                    "ServiceOperation": "unregisteredPayment",
                    "ServiceRegion": "C001",
                    "ServiceVersion": "1.2.0",
                },
            },
            "RequestBody": {
                "any": {
                    "unregisteredPaymentRQ": {
                        "phoneNumber": clean_phone,
                        "code": reference,
                        "value": str(int(amount_cop)),
                        "reference1": "RepuestosCel",
                        "reference2": reference,
                        "reference3": "",
                    }
                }
            },
        }
    }
    try:
        resp = urllib_request(
            f"{_nequi_api_base()}/payments/v2/-services-paymentservice-unregisteredpayment",
            method="POST",
            headers={
                "Authorization": f"Bearer {token}",
                "x-api-key": api_key,
                "Content-Type": "application/json",
                "Accept": "application/json",
            },
            body=json.dumps(payload).encode(),
        )
        # Success: Status.StatusCode == "0"
        status_code = (
            resp.get("ResponseMessage", {})
            .get("ResponseHeader", {})
            .get("Status", {})
            .get("StatusCode", "")
        )
        tx_id = (
            resp.get("ResponseMessage", {})
            .get("ResponseBody", {})
            .get("any", {})
            .get("unregisteredPaymentRS", {})
            .get("transactionId", reference)
        )
        if status_code == "0":
            return True, tx_id, ""
        status_desc = (
            resp.get("ResponseMessage", {})
            .get("ResponseHeader", {})
            .get("Status", {})
            .get("StatusDesc", "nequi_push_error")
        )
        return False, "", status_desc
    except Exception as e:
        return False, "", str(e)


def query_nequi_payment_status(transaction_id):
    """
    Poll Nequi for payment status.
    Docs: getStatusPayment endpoint
    Status codes: 33=Pending, 35=Approved, 10-455=Cancelled, 10-454=Expired, 71=Failed
    """
    import uuid, datetime
    token = get_nequi_token()
    api_key = get_nequi_api_key()
    if not token or not transaction_id:
        return {
            "status": "PENDING",
            "statusMessage": "Esperando aprobación desde la app Nequi",
            "rawStatus": "",
            "responseCode": "",
            "transactionId": transaction_id or "",
        }

    message_id = str(uuid.uuid4()).replace("-", "")[:10].upper()
    now = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=-5)))
    payload = {
        "RequestMessage": {
            "RequestHeader": {
                "Channel": "PNP04-C001",
                "RequestDate": now.strftime("%Y-%m-%dT%H:%M:%S.000-05:00"),
                "MessageID": message_id,
                "ClientID": get_nequi_client_id(),
                "Destination": {
                    "ServiceName": "PaymentsService",
                    "ServiceOperation": "getStatusPayment",
                    "ServiceRegion": "C001",
                    "ServiceVersion": "1.0.0",
                },
            },
            "RequestBody": {
                "any": {
                    "getStatusPaymentRQ": {"codeQR": transaction_id}
                }
            },
        }
    }
    try:
        resp = urllib_request(
            f"{_nequi_api_base()}/payments/v2/-services-paymentservice-getstatuspayment",
            method="POST",
            headers={
                "Authorization": f"Bearer {token}",
                "x-api-key": api_key,
                "Content-Type": "application/json",
                "Accept": "application/json",
            },
            body=json.dumps(payload).encode(),
        )
        status_data = extract_nequi_payment_status(resp)
        status_data["transactionId"] = transaction_id
        return status_data
    except Exception as exc:
        return {
            "status": "PENDING",
            "statusMessage": f"No pudimos consultar Nequi todavía: {exc}",
            "rawStatus": "",
            "responseCode": "",
            "transactionId": transaction_id,
        }



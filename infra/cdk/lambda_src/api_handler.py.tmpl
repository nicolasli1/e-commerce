def get_nequi_token():
    """Exchange client credentials for Nequi OAuth2 access token."""
    import base64
    client_id = get_nequi_client_id()
    client_secret = get_nequi_client_secret()
    credentials = base64.b64encode(f"{client_id}:{client_secret}".encode()).decode()
    resp = urllib_request(
        "https://oauth.nequi.com.co/token",
        method="POST",
        headers={
            "Authorization": f"Basic {credentials}",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        body="grant_type=client_credentials".encode(),
    )
    return (resp.get("access_token") or "") if isinstance(resp, dict) else ""


def initiate_nequi_push_payment(phone_number, amount_cop, reference):
    """
    Push a payment notification to the customer's Nequi app.
    Docs: https://docs.conecta.nequi.com.co
    The user receives a push notification and approves in-app.
    Returns (success: bool, transaction_id: str, error: str)
    """
    import uuid, datetime
    api_key = get_nequi_api_key()
    token = get_nequi_token()
    if not token:
        return False, "", "nequi_token_error"

    message_id = str(uuid.uuid4()).replace("-", "")[:12].upper()
    now = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=-5)))
    request_date = now.strftime("%Y-%m-%dT%H:%M:%S.000-05:00")

    payload = {
        "RequestMessage": {
            "RequestHeader": {
                "Channel": "BT",
                "RequestDate": request_date,
                "MessageID": message_id,
                "ClientID": get_nequi_client_id(),
                "Destination": {
                    "Name": "PaymentGateway",
                    "NameSpace": "co.com.nequi.integration.payment",
                    "ServiceName": "PaymentGatewayService",
                    "ServiceOperation": "pushPayment",
                    "ServiceRegion": "C001",
                    "ServiceVersion": "1.2.0",
                },
            },
            "RequestBody": {
                "any": {
                    "pushPaymentRQ": {
                        "phoneNumber": phone_number.strip().lstrip("+57").replace(" ", ""),
                        "code": reference,
                        "value": str(int(amount_cop)),
                        "messageOTP": f"NexCore: confirma tu pago de ${int(amount_cop):,} COP",
                    }
                }
            },
        }
    }
    try:
        resp = urllib_request(
            "https://api.nequi.com.co/payments/-/push-payments",
            method="POST",
            headers={
                "Authorization": f"Bearer {token}",
                "x-api-key": api_key,
                "Content-Type": "application/json",
                "Accept": "application/json",
            },
            body=json.dumps(payload).encode(),
        )
        # Nequi returns ResponseMessage.ResponseHeader.responseCode == "00" on success
        code = (
            resp.get("ResponseMessage", {})
            .get("ResponseHeader", {})
            .get("ResponseCode", "99")
        )
        tx_id = (
            resp.get("ResponseMessage", {})
            .get("ResponseBody", {})
            .get("any", {})
            .get("pushPaymentRS", {})
            .get("transactionId", reference)
        )
        if code == "00":
            return True, tx_id, ""
        err = (
            resp.get("ResponseMessage", {})
            .get("ResponseHeader", {})
            .get("ResponseMessage", "nequi_push_error")
        )
        return False, "", err
    except Exception as e:
        return False, "", str(e)


def wompi_base_url(public_key=None):
    key = public_key or get_wompi_public_key()
    if key.startswith("pub_test_"):
        return "https://sandbox.wompi.co/v1"
    return "https://production.wompi.co/v1"


def http_json(method, url, headers=None, body=None):
    req = urllib.request.Request(url, method=method)
    for key, value in (headers or {}).items():
        req.add_header(key, value)
    if body is not None:
        payload = json.dumps(body).encode("utf-8")
        req.data = payload
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.getcode(), json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as err:
        try:
            data = json.loads(err.read().decode("utf-8"))
        except Exception:
            data = {"error": str(err)}
        return err.code, data


def generate_token(user_id, ttl_days=30):
    """Generate a signed token with expiration for the given user_id."""
    session_secret = get_session_secret()
    if not session_secret:
        raise RuntimeError("session_secret_not_configured")
    exp_ts = int(time.time()) + (ttl_days * 86400)
    payload = base64.b64encode(
        json.dumps({"sub": user_id, "iat": now_iso(), "exp": exp_ts}).encode()
    ).decode()
    sig = hmac.new(
        session_secret.encode(),
        payload.encode(),
        hashlib.sha256,
    ).hexdigest()
    return f"{payload}.{sig}"


def verify_token(token):
    """Verify a token and return the subject (user_id) if valid and not expired."""
    try:
        session_secret = get_session_secret()
        if not session_secret:
            return None
        parts = token.split(".")
        if len(parts) != 2:
            return None
        payload, sig = parts
        expected = hmac.new(
            session_secret.encode(),
            payload.encode(),
            hashlib.sha256,
        ).hexdigest()
        if not hmac.compare_digest(sig, expected):
            return None
        decoded = json.loads(base64.b64decode(payload).decode())
        # Check expiration
        exp = decoded.get("exp", 0)
        if exp and int(time.time()) > exp:
            return None
        return decoded.get("sub")
    except Exception:
        return None


def handle_login(event):
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    admin_user = get_admin_user()
    admin_pass_hash = get_admin_password_hash()
    session_secret = get_session_secret()
    if not admin_user or not admin_pass_hash or not session_secret:
        return response(503, {"error": "admin_auth_not_configured"})
    user = (body.get("username") or "").strip()
    pwd = (body.get("password") or "").strip()
    if user == admin_user and hashlib.sha256(pwd.encode()).hexdigest() == admin_pass_hash:
        token = generate_token("admin:" + user, ttl_days=1)
        return response(200, {"ok": True, "token": token})
    return response(401, {"error": "invalid_credentials"})


def register_user(event):
    """POST /api/auth/register — Create a new customer account."""
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    name = (body.get("name") or "").strip()
    email = (body.get("email") or "").strip().lower()
    phone = (body.get("phone") or "").strip()
    password = (body.get("password") or "").strip()
    if not name or not email or not password:
        return response(400, {"error": "name_email_password_required"})
    if len(password) < 6:
        return response(400, {"error": "password_too_short"})
    # Check duplicate email
    existing = users_table.query(
        IndexName="email-index",
        KeyConditionExpression="email = :e",
        ExpressionAttributeValues={":e": email},
    ).get("Items", [])
    if existing:
        return response(409, {"error": "email_already_registered"})
    user_id = str(uuid.uuid4())
    now = now_iso()
    item = {
        "userId": user_id,
        "email": email,
        "name": name,
        "phone": phone,
        "passwordHash": hashlib.sha256(password.encode()).hexdigest(),
        "createdAt": now,
        "updatedAt": now,
    }
    users_table.put_item(Item=item)
    token = generate_token(user_id, ttl_days=30)
    return response(201, {
        "ok": True,
        "userId": user_id,
        "token": token,
        "user": {"name": name, "email": email},
    })


def login_user(event):
    """POST /api/auth/login — Authenticate a customer."""
    body = get_json_body(event)
    if not body:
        return response(400, {"error": "invalid_json"})
    email = (body.get("email") or "").strip().lower()
    password = (body.get("password") or "").strip()
    if not email or not password:
        return response(400, {"error": "email_and_password_required"})
    existing = users_table.query(
        IndexName="email-index",
        KeyConditionExpression="email = :e",
        ExpressionAttributeValues={":e": email},
    ).get("Items", [])
    if not existing:
        return response(401, {"error": "invalid_credentials"})
    user = existing[0]
    if user.get("passwordHash") != hashlib.sha256(password.encode()).hexdigest():
        return response(401, {"error": "invalid_credentials"})
    token = generate_token(user["userId"], ttl_days=30)
    return response(200, {
        "ok": True,
        "token": token,
        "user": {"name": user.get("name", ""), "email": user.get("email", "")},
    })


def auth_required(event):
    """Extract authenticated user ID from Authorization header.
    Returns userId string or None."""
    headers = event.get("headers", {}) or {}
    auth = headers.get("authorization", "") or headers.get("Authorization", "")
    if auth.startswith("Bearer "):
        return verify_token(auth[7:])
    return None


def get_user_orders(event):
    """GET /api/orders — List orders for the authenticated user."""
    user_id = auth_required(event)
    if not user_id:
        return response(401, {"error": "unauthorized"})
    # Scan orders and filter by customer email (linked via userId or email)
    user_item = users_table.get_item(Key={"userId": user_id}).get("Item")
    if not user_item:
        return response(404, {"error": "user_not_found"})
    user_email = user_item.get("email", "")
    all_orders = orders_table.scan().get("Items", [])
    # Match by customer email
    user_orders = [
        o for o in all_orders
        if (o.get("customer") or {}).get("email", "").lower() == user_email
    ]
    user_orders.sort(key=lambda x: x.get("createdAt", ""), reverse=True)
    safe = [{
        "reference": o.get("reference", ""),
        "status": o.get("status", ""),
        "fulfillmentStatus": o.get("fulfillmentStatus", ""),
        "amountInCents": o.get("amountInCents", 0),
        "items": o.get("items", []),
        "customer": o.get("customer", {}),
        "shippingAddress": o.get("shippingAddress", {}),
        "trackingNumber": o.get("trackingNumber", ""),
        "courier": o.get("courier", ""),
        "createdAt": o.get("createdAt", ""),
        "updatedAt": o.get("updatedAt", ""),
    } for o in user_orders]
    return response(200, {"ok": True, "orders": safe})


def admin_auth_required(event):
    headers = event.get("headers", {}) or {}
    auth = headers.get("authorization", "") or headers.get("Authorization", "")
    if auth.startswith("Bearer "):
        return verify_token(auth[7:])
    return None


def require_api_key(event):
    """
    Validates x-api-key header for non-admin endpoints (checkout, leads).
    The frontend includes this key to prevent direct API abuse.
    """
    headers = event.get("headers", {}) or {}
    provided = headers.get("x-api-key", "") or headers.get("X-Api-Key", "") or ""
    expected = get_api_key()
    if not expected:
        # No key configured — allow (dev mode). Should be set in production.
        return True
    if provided == expected:
        return True
    return False



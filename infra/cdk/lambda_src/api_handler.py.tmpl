def create_product(body):
    if not body:
        return response(400, {"error": "invalid_json"})
    for field in ["name", "price"]:
        if not body.get(field):
            return response(400, {"error": f"missing_field: {field}"})
    images_raw = body.get("images") or []
    images_parsed = []
    for img in images_raw:
        if isinstance(img, dict) and img.get("lg"):
            images_parsed.append({"lg": img["lg"], "md": img.get("md", ""), "sm": img.get("sm", "")})
    image_url = (body.get("imageUrl") or "").strip()
    if image_url and not images_parsed:
        images_parsed.append({"lg": image_url, "md": image_url, "sm": image_url})
    elif not image_url and images_parsed:
        image_url = images_parsed[0].get("lg", "")
    item = {
        "productId": str(uuid.uuid4()),
        "name": body["name"].strip(),
        "description": (body.get("description") or "").strip(),
        "price": Decimal(str(body["price"])),
        "category": normalize_category(body.get("category")),
        "imageUrl": image_url,
        "images": images_parsed,
        "stock": int(body.get("stock", 0)),
        "quality": (body.get("quality") or "").strip(),
        "compatibility": [
            str(model).strip()
            for model in (body.get("compatibility") or [])
            if str(model).strip()
        ],
        "shippingTime": (body.get("shippingTime") or "").strip(),
        "warranty": (body.get("warranty") or "").strip(),
        "status": body.get("status", "active").strip(),
        "variants": _parse_variants(body.get("variants") or []),
        "deviceFamilies": _extract_device_families(body.get("variants") or []),
        "createdAt": now_iso(),
        "updatedAt": now_iso(),
    }
    products_table.put_item(Item=item)
    return response(201, {"ok": True, "product": item})


def update_product(product_id, body):
    if not body:
        return response(400, {"error": "invalid_json"})
    existing = products_table.get_item(Key={"productId": product_id}).get("Item")
    if not existing:
        return response(404, {"error": "not_found"})
    updates = {}
    for field in ["name", "description", "imageUrl", "status", "quality", "shippingTime", "warranty"]:
        if field in body:
            updates[field] = body[field]
    if "compatibility" in body:
        updates["compatibility"] = [
            str(model).strip()
            for model in (body.get("compatibility") or [])
            if str(model).strip()
        ]
    if "images" in body:
        images_raw = body["images"]
        images_parsed = []
        for img in images_raw:
            if isinstance(img, dict) and img.get("lg"):
                images_parsed.append({"lg": img["lg"], "md": img.get("md", ""), "sm": img.get("sm", "")})
        updates["images"] = images_parsed
        if images_parsed and "imageUrl" not in body:
            updates["imageUrl"] = images_parsed[0].get("lg", existing.get("imageUrl", ""))
    elif "imageUrl" in body:
        existing_images = existing.get("images", [])
        if existing_images:
            existing_images[0]["lg"] = body["imageUrl"]
            updates["images"] = existing_images
    if "category" in body:
        updates["category"] = normalize_category(body.get("category"))
    if "price" in body:
        updates["price"] = Decimal(str(body["price"]))
    if "stock" in body:
        updates["stock"] = int(body["stock"])
    if "variants" in body:
        updates["variants"] = _parse_variants(body.get("variants") or [])
        updates["deviceFamilies"] = _extract_device_families(body.get("variants") or [])
    updates["updatedAt"] = now_iso()
    update_expr = "SET " + ", ".join(f"#{k}=:v{k}" for k in updates)
    attr_names = {f"#{k}": k for k in updates}
    attr_vals = {f":v{k}": v for k, v in updates.items()}
    products_table.update_item(
        Key={"productId": product_id},
        UpdateExpression=update_expr,
        ExpressionAttributeNames=attr_names,
        ExpressionAttributeValues=attr_vals,
        ReturnValues="ALL_NEW",
    )
    updated = products_table.get_item(Key={"productId": product_id}).get("Item")
    return response(200, {"ok": True, "product": updated})


def delete_product(product_id):
    existing = products_table.get_item(Key={"productId": product_id}).get("Item")
    if not existing:
        return response(404, {"error": "not_found"})
    products_table.update_item(
        Key={"productId": product_id},
        UpdateExpression="SET #st=:st, #ut=:ut",
        ExpressionAttributeNames={"#st": "status", "#ut": "updatedAt"},
        ExpressionAttributeValues={":st": "deleted", ":ut": now_iso()},
    )
    return response(200, {"ok": True, "deleted": product_id})


def seed_products():
    created = []
    existing_items = products_table.scan().get("Items", [])
    existing_by_name = {item.get("name", "").strip().lower(): item for item in existing_items}
    for sample in SAMPLE_PRODUCTS:
        existing = existing_by_name.get(sample["name"].strip().lower())
        item = {
            "productId": existing.get("productId") if existing else str(uuid.uuid4()),
            "name": sample["name"],
            "description": sample["description"],
            "price": sample["price"],
            "category": sample["category"],
            "imageUrl": sample.get("imageUrl", ""),
            "stock": sample["stock"],
            "status": "active",
            "createdAt": existing.get("createdAt", now_iso()) if existing else now_iso(),
            "updatedAt": now_iso(),
        }
        products_table.put_item(Item=item)
        created.append(item)
    return response(200, {"ok": True, "products": created, "seeded": len(created)})


